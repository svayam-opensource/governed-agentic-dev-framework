<?xml version="1.0" encoding="utf-8"?>
<!--
  gov for Windows: a per-user MSI (PRJ-121 plan 04 T13; spec 04 §4.2, rulings Q4 A, Q5 A, Q11).

  %LOCALAPPDATA%\Programs\gov\
      node\   private Node 24            (never on PATH)
      app\    gov + node_modules
      bin\    gov.cmd                     (the ONLY directory added to the user's PATH)

  No elevation, nothing machine-wide. Upgrades: MajorUpgrade under a FIXED UpgradeCode (winget upgrade Svayam.Gov).
  Uninstall removes node\ app\ bin\ — including agents gov installed into node\ and the shims it wrote in bin\ — and
  the PATH entry. It never touches ~/.gov (the user's workspaces and preferences).

  The file list (GovFiles) is generated from the staged tree by lib/wxs.mjs. Built by scripts/build.mjs.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <!-- NEVER CHANGE the UpgradeCode: it is how a newer gov MSI finds and replaces an older one. -->
  <Package Name="gov"
           Manufacturer="Svayam Infoware Pvt. Ltd."
           Version="$(var.ProductVersion)"
           UpgradeCode="268AC4D8-02EB-421C-A672-55862FFF1985"
           Scope="perUser"
           Language="1033"
           Compressed="yes"
           InstallerVersion="500">
    <SummaryInformation Description="gov — the Governed Agentic Development Framework CLI" />

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of gov is already installed. Uninstall it first to go back." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <!-- ARPNOMODIFY ("no Change button") comes with WixUI_Minimal. -->

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/svayam-opensource/governed-agentic-dev-framework" />
    <Property Id="ARPHELPLINK" Value="https://github.com/svayam-opensource/governed-agentic-dev-framework/blob/main/docs/installing.md" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="gov" />
      </Directory>
    </StandardDirectory>

    <!--
      WHAT gov ADDS AFTER INSTALL, removed on uninstall too: npm installs agents into node\ (npm's global prefix is
      node.exe's directory) and gov writes bin\<agent>.cmd shims. Windows Installer removes only the files it laid
      down, so RemoveFolderEx clears the whole install root — on a real uninstall only. During a MajorUpgrade the old
      package is uninstalled too, and the user's agents must survive that, so GOVLEFTOVERS is set only when
      REMOVE="ALL" and no upgrade is in progress.
    -->
    <Property Id="GOVINSTALLROOT">
      <RegistrySearch Id="GovInstallRootSearch" Root="HKCU" Key="Software\Svayam\gov" Name="InstallRoot" Type="raw" />
    </Property>
    <Property Id="GOVLEFTOVERS" Secure="yes" />
    <SetProperty Id="GOVLEFTOVERS" Value="[GOVINSTALLROOT]" After="AppSearch" Sequence="both"
                 Condition="GOVINSTALLROOT AND REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="GovInstallRoot" Guid="7C3B9F0E-5A21-4E8D-9B6A-2F4C1D8E0A53">
        <RegistryValue Root="HKCU" Key="Software\Svayam\gov" Name="InstallRoot" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
        <util:RemoveFolderEx On="uninstall" Property="GOVLEFTOVERS" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="gov" Level="1">
      <ComponentGroupRef Id="GovFiles" />
      <ComponentRef Id="GovInstallRoot" />
    </Feature>

    <!--
      FIRST RUN. The finish page offers "Launch gov" (ticked): a new console in the user's home running gov, which is
      the first-run flow. A silent install (winget, msiexec /qn) shows no page; winget's release notes and the docs say
      "run gov in a new terminal" instead.
    -->
    <CustomAction Id="LaunchGov"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[System64Folder]cmd.exe&quot; /k &quot;cd /d &quot;[%USERPROFILE%]&quot; &amp;&amp; &quot;[BINFOLDER]gov.cmd&quot;&quot;"
                  Return="asyncNoWait"
                  Impersonate="yes" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch gov" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
    <ui:WixUI Id="WixUI_Minimal" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchGov"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
  </Package>
</Wix>
