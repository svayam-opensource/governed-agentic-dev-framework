{
  "include": ["index.ts", "src/**/*.ts"],
  "exclude": ["test", "node_modules", "lib"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./lib/esm",
    "rootDir": ".",
    "declaration": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true
  }
}
