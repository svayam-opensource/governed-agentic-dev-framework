# Cross-platform line endings: shell scripts MUST stay LF or they break on
# a Windows checkout (CRLF corrupts the shebang and arg parsing under bash).
* text=auto eol=lf
*.sh    text eol=lf
*.bash  text eol=lf
*.bats  text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.mdc   text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.lock  text eol=lf
prj                text eol=lf
bin/prj            text eol=lf
setup.sh           text eol=lf
install.sh         text eol=lf
Jenkinsfile        text eol=lf
.framework-version text eol=lf
# Test-bed golden snapshots are byte-compared — must never be CRLF.
tests/bats/golden/** text eol=lf
*.png  binary
