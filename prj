cmd_list() {
  # GitHub-derived (registry-elimination): the project set is the org's GitHub
  # Project boards — no registry read.
  #   prj list       → ongoing only: OPEN boards (active/paused).
  #   prj list-all   → every board incl. closed (completed/cancelled), newest first.
  # id/status/owners are derived; the frozen shim grandfathers legacy ids only.
  local mode="open"
  case "${1:-}" in all|--all|-a) mode="all" ;; esac
  if [[ "$mode" == "all" ]]; then header "All Projects (newest first)"; else header "Ongoing Projects (active / paused)"; fi
  divider
  # Reuse project_context_list — ONE batched GraphQL query (fast), not a per-board
  # fan-out. ongoing = open boards (active/paused); all = ongoing + done. We never
  # show 'not-initiated' (un-seeded) boards here — those are project candidates,
  # not projects.
  local lifecycle rows
  [[ "$mode" == "all" ]] && lifecycle="any" || lifecycle="ongoing"
  rows="$(project_context_list any "$lifecycle")"
  local pid url status who scol shown=0
  local out=""
  while IFS=$'\t' read -r pid url status who; do
    [[ -z "$pid" || "$pid" == "(not seeded)" || "$status" == "not-initiated" ]] && continue
    case "$status" in
      active) scol="$GREEN" ;; paused) scol="$YELLOW" ;;
      completed) scol="$CYAN" ;; cancelled) scol="$RED" ;; *) scol="$DIM" ;;
    esac
    out+="$(printf "  ${BOLD}%-32s${NC} ${scol}%-11s${NC} ${DIM}%s${NC}" "$pid" "$status" "${who//,/, }")"$'\n'
    shown=$((shown+1))
  done <<< "$rows"
  # newest first for list-all (project_context_list returns ascending by board #)
  if [[ "$mode" == "all" ]]; then
    printf '%s' "$out" | { tac 2>/dev/null || tail -r 2>/dev/null || cat; }
  else
    printf '%s' "$out"
  fi
  [[ $shown -eq 0 ]] && echo "  No ${mode/open/ongoing} projects."
  if [[ "$mode" != "all" ]]; then
    echo ""; echo -e "  ${DIM}Closed boards (completed/cancelled) hidden — 'prj list-all' to show all.${NC}"
  fi
  echo ""
}

cmd_status() {
  header "Project Status"
  divider
  echo ""
  # #102.1: ask for the GitHub project NUMBER directly. Listing every board to
  # pick from is slow; the number is right there in the board URL (…/projects/<N>).
  local owner="$GITHUB_ORG" NUM PROJECT_ID PF title
  ask NUM "GitHub project number (from the board URL …/projects/<N>)"
  [[ "$NUM" =~ ^[0-9]+$ ]] || { err "Project number must be numeric (e.g. 43)."; return 1; }
  title="$(gh_board_title "$NUM" "$owner" 2>/dev/null)"
  [[ -n "$title" ]] || { err "No GitHub Project #$NUM under '$owner' (or you lack access)."; return 1; }
  PROJECT_ID="$(derive_project_id "$NUM" "$owner" 2>/dev/null)"
  PF="$SCRIPT_DIR/projects/${PROJECT_ID}/project.yaml"
  echo ""
  divider
  if [[ -z "$PROJECT_ID" || ! -f "$PF" ]]; then
    # Active project: the manifest lives on the project branch (or this is the
    # gov/common home). Derive the summary live from GitHub (registry-elimination).
    local status branch owners gh_url scol
    status="$(derive_project_status "$NUM" "$owner")"
    branch="$(derive_project_branch "$NUM" "$owner")"
    owners="$(project_owners "$NUM" "$owner" | paste -sd ',' - | sed 's/,/, /g')"
    gh_url="https://github.com/orgs/$owner/projects/$NUM"
    case "$status" in active) scol="$GREEN";; paused) scol="$YELLOW";; completed) scol="$CYAN";; cancelled) scol="$RED";; *) scol="$DIM";; esac
    echo -e "  ${BOLD}ID:${NC}          $PROJECT_ID"
    echo -e "  ${BOLD}Status:${NC}      ${scol}${status}${NC}"
    echo -e "  ${BOLD}Owners:${NC}      ${owners:-(no anchor assignees)}"
    echo -e "  ${BOLD}Branch:${NC}      $branch"
    echo -e "  ${BOLD}GitHub:${NC}      $gh_url"
    echo -e "  ${DIM}Full manifest (repos / tasks) lives on the project branch — run from the project's PRJ_GOV clone for detail.${NC}"
    echo ""
    return
  fi
  python3 - "$PF" <<'PY'
import sys, yaml
BOLD='\033[1m'; NC='\033[0m'; DIM='\033[2m'; GREEN='\033[0;32m'
YELLOW='\033[1;33m'; RED='\033[0;31m'; CYAN='\033[0;36m'
c = yaml.safe_load(open(sys.argv[1]))
status_colour = {'active': GREEN, 'paused': YELLOW, 'completed': CYAN, 'cancelled': RED}
s = c.get('status','?')
sc = status_colour.get(s,'')
print(f"  {BOLD}ID:{NC}          {c.get('id','')}")
print(f"  {BOLD}Status:{NC}      {sc}{s}{NC}")
print(f"  {BOLD}Assigned to:{NC} {c.get('assigned_to','')}")
print(f"  {BOLD}Started:{NC}     {c.get('started_at') or '—'}")
print(f"  {BOLD}Paused:{NC}      {c.get('paused_at') or '—'}")
print(f"  {BOLD}GitHub:{NC}      {c.get('github_project','')}")
print()
repos = [r for r in (c.get('repos') or []) if r and r.get('url')]
if repos:
    print(f"  {BOLD}Repos ({len(repos)}):{NC}")
    for r in repos:
        print(f"    {DIM}•{NC} {r['url']}  {DIM}[{r.get('role','?')} / base: {r.get('base_branch','?')}]{NC}")
tasks = [t for t in (c.get('tasks') or []) if t and t.get('id')]
if tasks:
    print()
    print(f"  {BOLD}Tasks ({len(tasks)}):{NC}")
    for t in tasks:
        ts = t.get('status','?')
        tc = GREEN if ts == 'completed' else (YELLOW if ts == 'active' else '')
        print(f"    {DIM}•{NC} {t['id']}  {tc}{ts}{NC}")
PY
  echo ""
}

