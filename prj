# ── Config (the (a)-step of config-as-build; PRJ-012 config-as-build design) ───
# `prj config scaffold <unit> [--write]` | `prj config check <path>`. The tool PROPOSES
# a per-unit deploy.yaml (derived facts re-derived; intent lifted for review) and CI
# drift-gates the committed copy. Reads the WORKING TREE (a dev-machine authoring op),
# like `deploy --local`. Step-1 additive: the gov services.yaml is still the catalog SoT.
cmd_config() {
  local DEPLOY="$SCRIPTS/deploy"
  local action="${1:-}"; shift || true
  case "$action" in
    scaffold|check) ;;
    ""|--help|-h) cmd_help config; return 0 ;;
    *) err "config: unknown action '$action' (expected: scaffold | check)"; return 1 ;;
  esac
  # Authoring is always a WIP op → the PROJECT workspace (you can only author through a
  # project; gov main is reached later via PR). cwd-resolved, else pick.
  resolve_workspace local || return 1
  exec python3 "$DEPLOY/catalog.py" descriptor "$action" "$@"
}

# ── Deploy (polymorphic backend; PRJ-012 deploy design) ────────────────────────
# `prj deploy <target> <--local | --dev | --uat | --prod> [flags]`. ONE verb, backend by env:
#   --local            → scripts/deploy/serve-local.sh   (watch/serve + Tier-2 ladder)
#   --dev/--uat/--prod → scripts/deploy/jenkins.sh        (build-once-promote, remote)
# Env is REQUIRED (no default — guards against an accidental prod deploy). Provisioning
# is folded in via --provision (no separate verb). uat/prod confirm interactively unless
# --yes; full token-gating is tracked in svm-prj-work#86.
cmd_deploy() {
  local DEPLOY="$SCRIPTS/deploy"
  local target="" env="" action="up"
  local detach=0 image=0 dryrun=0 yes=0 provision=0 noprovision=0 seed=0 all=0 follow=0 skipapproval=0
  local pin="" branch="" agent="" config_dir="" register_app=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --local)              env="local" ;;
      --dev|--development)   env="development" ;;
      --uat|--staging)       env="staging" ;;
      --prod|--production)   env="production" ;;
      -d|--detach)           detach=1 ;;
      --image)               image=1 ;;
      --provision)           provision=1 ;;
      --no-provision)        noprovision=1 ;;   # opt out of local's auto-provision
      --seed)                seed=1 ;;          # local: FRESH reseed — WIPE data + migrate + load curated init data (implies provision)
      --dry-run|--plan)      dryrun=1 ;;
      -y|--yes)              yes=1 ;;
      -f|--follow)           follow=1 ;;
      --logs)                action="logs" ;;
      --stop)                action="stop" ;;
      --all)                 all=1 ;;            # with --stop: also bring down Tier-2 containers
      --skip-approval)       skipapproval=1 ;;
      --pin|--image-tag)     shift; pin="${1:-}" ;;
      --branch)              shift; branch="${1:-}" ;;
      --agent)               shift; agent="${1:-}" ;;
      --config-dir)          shift; config_dir="${1:-}" ;;
      --register-app)        shift; register_app="${1:-}" ;;
      -*)                    err "deploy: unknown flag '$1'"; return 1 ;;
      *) if [[ -z "$target" ]]; then target="$1"; else err "deploy: unexpected argument '$1'"; return 1; fi ;;
    esac
    shift
  done
  [[ -n "$target" ]] || { err "Usage: prj deploy <target> <--local | --dev | --uat | --prod> [flags]"; return 1; }
  [[ -n "$env" ]]    || { err "deploy: an environment is REQUIRED — exactly one of --local | --dev | --uat | --prod."; return 1; }

  # Provision policy: LOCAL auto-provisions (hermetic, disposable env — "deploy just works";
  # bootstrap reuses the volume, never wipes), opt out with --no-provision. Remote stays
  # explicit (--provision) so shared infra is never stood up silently. --seed needs the
  # substrate up + migrated, so it forces provision regardless.
  [[ "$env" == "local" && "$noprovision" == 0 ]] && provision=1
  [[ "$noprovision" == 1 ]] && provision=0
  [[ "$seed" == 1 ]] && provision=1

  # Resolve the workspace by env (the SAME way every catalog/data command does): local reads
  # the WIP PROJECT (working tree); dev/uat/prod read the gov repo (committed main).
  resolve_workspace "$env" || return 1

  # ── LOCAL: serve-local.sh (watch/serve orchestrator) ──────────────────────────
  if [[ "$env" == "local" ]]; then
    info "local workspace: $WORKSPACE_ROOT"
    local args=("$target")
    [[ "$action" == "stop" ]] && args+=(--stop)
    [[ "$all"    == 1 ]]      && args+=(--all)
    [[ "$action" == "logs" ]] && args+=(--logs)
    [[ "$detach"   == 1 ]]    && args+=(-d)
    [[ "$image"    == 1 ]]    && args+=(--image)
    [[ "$provision" == 1 ]]   && args+=(--provision)
    [[ "$seed"     == 1 ]]    && args+=(--seed)
    [[ "$yes"      == 1 ]]    && args+=(--yes)
    if [[ "$dryrun" == 1 ]]; then
      info "DRY-RUN (local): bash $DEPLOY/serve-local.sh ${args[*]}"
      python3 "$DEPLOY/catalog.py" resolve "$target" --env local 2>/dev/null || true
      return 0
    fi
    exec bash "$DEPLOY/serve-local.sh" "${args[@]}"
  fi

  # ── REMOTE (dev/uat/prod): trigger the Jenkins deploy job per built unit ───────
  [[ "$seed" == 1 ]] && warn "deploy: --seed is local-only for now (the seed hook targets the local DB); seed remote envs separately once the seed hook supports them."
  local suffix; case "$env" in development) suffix="dev";; staging) suffix="uat";; production) suffix="prod";; esac
  local units
  # `resolve` exits non-zero for a target not yet in graph.lock (e.g. a brand-new
  # unit) — tolerate that under `set -e` so the fallback below applies (the unit is
  # still in the raw services.yaml the pipeline reads). The trailing `|| true`
  # keeps the command substitution from aborting the script.
  units=$(python3 "$DEPLOY/catalog.py" resolve "$target" --env "$env" --format json 2>/dev/null \
    | python3 -c 'import sys,json
try:
    ms=json.load(sys.stdin)
except Exception:
    ms=[]
print("\n".join(m["service"] for m in ms if m.get("kind") in ("api","spa")))' 2>/dev/null || true)
  [[ -n "$units" ]] || units="$target"

  # Interim safety (svm-prj-work#86): confirm uat/prod unless --yes.
  if [[ "$env" == "staging" || "$env" == "production" ]] && [[ "$yes" != 1 ]]; then
    warn "Deploying '$target' to $(printf '%s' "$env" | tr '[:lower:]' '[:upper:]') — units: $(echo "$units" | tr '\n' ' ')"
    warn "Token-gated authorization is tracked in svm-prj-work#86; for now confirm interactively."
    printf "  Type '%s' to proceed: " "$suffix"
    read -r confirm
    [[ "$confirm" == "$suffix" || "$confirm" == "$env" ]] || { err "Confirmation mismatch — aborted."; return 1; }
  fi

  # Read a unit's catalog fact (prj is the single interface: it resolves the facts
  # and passes them to the param-driven pipeline). yq if present, else pyyaml.
  _cat_get() {  # <unit> <dot-path-after-unit>
    local cf="$WORKSPACE_ROOT/knowledge/deployment/catalog/services.yaml" v
    if command -v yq >/dev/null 2>&1; then
      v=$(yq ".services.\"$1\".$2" "$cf" 2>/dev/null)
    else
      v=$(SVC="$1" P="$2" python3 - "$cf" <<'PY' 2>/dev/null
import sys, os, yaml
d = (yaml.safe_load(open(sys.argv[1])) or {}).get('services', {}).get(os.environ['SVC'], {})
for k in os.environ['P'].split('.'):
    d = (d or {}).get(k) if isinstance(d, dict) else None
print('' if d is None else d)
PY
)
    fi
    [[ "$v" == "null" ]] && v=""
    printf '%s' "$v"
  }
  local u rc=0
  for u in $units; do
    # Job path per the jenkins-job-organization standard: <workspace_repo>/<activity>/<env>/<unit>.
    local job="${WORKSPACE_REPO}/deploy/${suffix}/${u}"
    # Resolve the unit's deploy facts from the catalog and pass them to the pipeline.
    local urepo uhost uport uhealth
    urepo=$(_cat_get "$u" repo)
    uhost=$(_cat_get "$u" "hosts.$suffix")
    uport=$(_cat_get "$u" "serve.port"); [[ -z "$uport" ]] && uport="8080"
    uhealth=$(_cat_get "$u" "healthcheck.path"); [[ -z "$uhealth" ]] && uhealth="/health"
    local params=("UNIT=$u" "DEPLOY_ENV=$env" "UNIT_REPO=$urepo" "DEPLOY_HOST=$uhost" "SERVE_PORT=$uport" "HEALTH_PATH=$uhealth")
    [[ "$action" == "stop" ]] && params+=("ACTION=stop")
    [[ -n "$agent" ]]        && params+=("AGENT_LABEL=$agent")
    [[ -n "$pin" ]]          && params+=("IMAGE_TAG_OVERRIDE=$pin")
    [[ -n "$branch" ]]       && params+=("BUILD_BRANCH=$branch" "PORTAL_BRANCH=$branch")  # unit-specific; Jenkins ignores undeclared
    [[ -n "$config_dir" ]]   && params+=("IAM_DEPLOY_DIR=$config_dir")
    [[ -n "$register_app" ]] && params+=("REGISTER_APP_SPEC=$register_app")
    [[ "$skipapproval" == 1 ]] && params+=("SKIP_PROD_APPROVAL=true")
    if [[ "$dryrun" == 1 ]]; then
      info "DRY-RUN (remote): ensure-job $job; then $([[ $follow == 1 ]] && echo run || echo trigger) ${params[*]}"
      continue
    fi
    # Provision the job from the catalog if it's a first-time unit (no human in
    # Jenkins): create the folder chain + Pipeline-from-SCM job, then trigger.
    # The job's SCM is the gov repo (built from github_org + workspace_repo —
    # prj reads those, not org_repo_url). credentialsId via $JENKINS_SCM_CREDENTIAL_ID.
    JENKINS_SCM_URL="git@github.com:${GITHUB_ORG}/${WORKSPACE_REPO}.git" JENKINS_SCM_BRANCH="${DEFAULT_BRANCH:-main}" \
      bash "$DEPLOY/jenkins.sh" ensure-job "$job" || { rc=$?; warn "deploy: could not ensure job $job — skipping trigger."; continue; }
    info "deploy: $job  (${params[*]})"
    if [[ "$follow" == 1 ]]; then
      bash "$DEPLOY/jenkins.sh" run "$job" "${params[@]}" || rc=$?
    else
      bash "$DEPLOY/jenkins.sh" trigger "$job" "${params[@]}" || rc=$?
    fi
  done
  return $rc
}

# ── Publish — ship the prj CLI to npm via the governed Jenkins job (single interface) ──
# `prj publish [<ref>] [--dist-tag <tag>] [--dry-run] [-y] [--no-follow]`
# Triggers <workspace>/publish/prod/prj (auto-provisioned): clones the CLI source
# repo at <ref>, gates it (syntax + version-sync + npm pack), then `npm publish`
# with the npm token from the Jenkins credential `npmjs-token` — the token lives in
# Jenkins, never on a laptop. Default <ref> = v<package.json version>.
cmd_publish() {
  case "${1:-}" in -h|--help) cmd_help publish; return 0 ;; esac
  local DEPLOY="$SCRIPTS/deploy"
  local ref="" dist="latest" dryrun=0 follow=1 yes=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dist-tag)  dist="${2:-latest}"; shift 2 ;;
      --dry-run)   dryrun=1; shift ;;
      --no-follow) follow=0; shift ;;
      -y|--yes)    yes=1; shift ;;
      -*)          err "publish: unknown flag '$1'"; return 1 ;;
      *)           ref="$1"; shift ;;
    esac
  done
  # CLI source repo + default version come from THIS checkout's package.json.
  local pkgjson="$SCRIPT_DIR/package.json"
  [[ -f "$pkgjson" ]] || { err "publish: package.json not found at $pkgjson"; return 1; }
  local pubrepo ver
  pubrepo=$(python3 -c "import json,re; r=json.load(open('$pkgjson')).get('repository',{}); u=r.get('url','') if isinstance(r,dict) else r; m=re.search(r'github\.com[/:]([^/]+/[^/.]+)', u or ''); print(m.group(1) if m else '')")
  ver=$(python3 -c "import json; print(json.load(open('$pkgjson')).get('version',''))")
  [[ -n "$pubrepo" ]] || { err "publish: could not derive the CLI repo from package.json repository.url"; return 1; }
  [[ -n "$ref" ]] || ref="v$ver"
  local job="${WORKSPACE_REPO}/publish/prod/prj"
  local dval; dval=$([[ $dryrun == 1 ]] && echo true || echo false)
  local params=("PUBLISH_REPO=$pubrepo" "PUBLISH_REF=$ref" "DIST_TAG=$dist" "DRY_RUN=$dval")
  header "Publish CLI — $pubrepo@$ref → npm (dist-tag=$dist · dry-run=$dval)"
  if [[ $dryrun == 0 && $yes == 0 ]]; then
    confirm "Publish $pubrepo@$ref to npm as '$dist'? This is IRREVERSIBLE." || { info "aborted."; return 1; }
  fi
  # Auto-provision the publish job (folder chain + Pipeline-from-SCM publish.Jenkinsfile);
  # the job's SCM is the gov repo on its default branch.
  JENKINS_SCM_URL="git@github.com:${GITHUB_ORG}/${WORKSPACE_REPO}.git" JENKINS_SCM_BRANCH="${DEFAULT_BRANCH:-main}" \
    bash "$DEPLOY/jenkins.sh" ensure-job "$job" || { err "publish: could not ensure job $job."; return 1; }
  info "publish: $job  (${params[*]})"
  local rc=0
  if [[ "$follow" == 1 ]]; then
    bash "$DEPLOY/jenkins.sh" run "$job" "${params[@]}" || rc=$?
  else
    bash "$DEPLOY/jenkins.sh" trigger "$job" "${params[@]}" || rc=$?
  fi
  return $rc
}

# ── Workspace context resolution (PRJ-012) ─────────────────────────────────────
# Two clones, two sources of truth, chosen by the ENV the command targets:
#   • GOV repo  = $ADF_WORKSPACE — cloned once, fixed, ALWAYS on `main`. The SoT for the
#     COMMITTED / deployed catalog (and registry, org-config, knowledge). Used for
#     dev|uat|prod. REQUIRED — if unset, we error (it's an environment precondition). Pulled
#     before reading so other developers' changes are present.
#   • PROJECT repo = a per-project clone under $AGENT_WORK_ROOT/<project>/ on a project
#     BRANCH — the work-in-progress SoT. Used for `local` and for authoring (config, catalog
#     build/check). Resolved from cwd (incl. a sibling member repo); else the developer picks
#     (only the developer knows which WIP project is meant).
# resolve_workspace <env> sets WORKSPACE_ROOT + ADF_WORKSPACE to the right clone.
#   env = dev|uat|prod (or development|staging|production) → GOV
#   env = local | "" (no-env authoring)                    → PROJECT
resolve_workspace() {
  # Record the canonical env so hooks (run_catalog_hook → materialize-repo.sh)
  # know which env to materialize the owner repo for (#109).
  case "${1:-local}" in
    development) RESOLVED_ENV=dev ;; staging) RESOLVED_ENV=uat ;; production) RESOLVED_ENV=prod ;;
    *) RESOLVED_ENV="${1:-local}" ;;
  esac
  export RESOLVED_ENV
  case "${1:-local}" in
    dev|uat|prod|development|staging|production) _resolve_gov_workspace ;;
    local|"")                                   _resolve_project_workspace ;;
    *) err "resolve_workspace: unknown env '$1'"; return 1 ;;
  esac
}

# Persist ADF_WORKSPACE so future shells pick it up automatically — to the developer's login
# SHELL RC (a user-specific OS setting; NEVER committed to the repo). Idempotent managed block.
_persist_adf_workspace() {
  local ws="$1" rc begin="# >>> prj ADF_WORKSPACE (managed by setup.sh) >>>" end="# <<< prj ADF_WORKSPACE <<<"
  case "$(basename "${SHELL:-bash}")" in
    zsh)  rc="$HOME/.zshrc" ;;
    bash) rc="$HOME/.bashrc" ;;
    *)    rc="$HOME/.profile" ;;
  esac
  touch "$rc" 2>/dev/null || { warn "could not write $rc — add 'export ADF_WORKSPACE=$ws' manually."; return 0; }
  if grep -qF "$begin" "$rc" 2>/dev/null; then            # replace any prior managed block
    awk -v b="$begin" -v e="$end" '$0==b{skip=1} !skip{print} $0==e{skip=0}' "$rc" >"$rc.tmp" && mv "$rc.tmp" "$rc"
  fi
  printf '%s\nexport ADF_WORKSPACE=%q\n%s\n' "$begin" "$ws" "$end" >> "$rc"
  info "Saved ADF_WORKSPACE to $rc — automatic in new shells (this run already uses it)."
}

# Ensure $ADF_WORKSPACE points at the gov repo. The shared contract for every command that
# needs it: set+valid → use; missing → ASK (interactive) and persist to the shell rc;
# non-interactive → error. Marker = org-config.yaml (the gov-repo signature).
ensure_adf_workspace() {
  [[ -n "${ADF_WORKSPACE:-}" && -f "$ADF_WORKSPACE/org-config.yaml" ]] && return 0
  if [[ ! -t 0 ]]; then
    err "ADF_WORKSPACE is not set to your gov repo. Set it (the $WORKSPACE_REPO clone on main) and retry:
    export ADF_WORKSPACE=<path>"
    return 1
  fi
  local p
  printf "  Your gov repo (\$ADF_WORKSPACE) isn't set. Enter the path to your %s clone (on main): " "$WORKSPACE_REPO" >&2
  IFS= read -r p || { err "aborted (no input)."; return 1; }
  p="${p/#\~/$HOME}"
  [[ -n "$p" && -d "$p" ]] || { err "not a directory: ${p:-<empty>}"; return 1; }
  p="$(cd "$p" && pwd)"
  [[ -f "$p/org-config.yaml" ]] || { err "$p doesn't look like a gov repo (no org-config.yaml)."; return 1; }
  export ADF_WORKSPACE="$p"
  _persist_adf_workspace "$p"
  ok "ADF_WORKSPACE → $p"
}

# GOV: ensure $ADF_WORKSPACE (the gov repo), then read its latest main.
_resolve_gov_workspace() {
  ensure_adf_workspace || return 1
  WORKSPACE_ROOT="$ADF_WORKSPACE"
  # The gov repo is the SoT for committed/main answers — pull so other devs' changes are in
  # (best-effort; PRJ_NO_PULL=1 skips it for offline/scripted use).
  [[ -n "${PRJ_NO_PULL:-}" ]] || git -C "$ADF_WORKSPACE" pull --ff-only -q 2>/dev/null \
    || warn "could not pull $ADF_WORKSPACE — reading local state (try: git -C \"$ADF_WORKSPACE\" pull)"
}

# PROJECT (WIP): the project clone containing cwd (or a sibling member repo); else the dev
# picks one. A project clone = a $WORKSPACE_REPO checkout on a project branch (NOT the gov
# clone, which stays on main). Identified by the catalog source it carries.
_resolve_project_workspace() {
  local rel="knowledge/deployment/catalog/services.yaml" d="$PWD" hit
  while [[ "$d" != "/" ]]; do
    [[ -f "$d/$rel" ]] && { WORKSPACE_ROOT="$d"; export ADF_WORKSPACE="$d"; return 0; }
    for hit in "$d"/*/"$rel"; do                  # a workspace clone alongside (member-repo cwd)
      [[ -f "$hit" ]] && { WORKSPACE_ROOT="${hit%/$rel}"; export ADF_WORKSPACE="${hit%/$rel}"; return 0; }
    done
    d="$(dirname "$d")"
  done
  # Not inside a project tree — let the developer choose (WIP is project-specific).
  local -a ws=() labels=(); local p wsdir
  for p in "$AGENT_WORK_ROOT"/*/"$WORKSPACE_REPO"/"$rel"; do
    [[ -f "$p" ]] || continue
    wsdir="${p%/$rel}"
    ws+=("$wsdir"); labels+=("$(basename "$(dirname "$wsdir")")")
  done
  [[ ${#ws[@]} -gt 0 ]] || { err "not inside a project and no projects under $AGENT_WORK_ROOT. cd into your project (or one of its member repos) and retry."; return 1; }
  if [[ ${#ws[@]} -eq 1 ]]; then WORKSPACE_ROOT="${ws[0]}"; export ADF_WORKSPACE="${ws[0]}"; return 0; fi
  echo "Select the project (work-in-progress) to use:" >&2
  local i; for i in "${!ws[@]}"; do printf "  %d) %s\n" "$((i+1))" "${labels[$i]}" >&2; done
  printf "  Choice [1]: " >&2; local c; read -r c; c="${c:-1}"
  local idx=$((c-1)); [[ $idx -ge 0 && $idx -lt ${#ws[@]} ]] || { err "invalid choice"; return 1; }
  WORKSPACE_ROOT="${ws[$idx]}"; export ADF_WORKSPACE="${ws[$idx]}"
}

# ── Catalog hooks (PRJ-012) — generic verb → app-owned script dispatch ──────────
# The catalog declares `hooks.<name> = { repo, cmd }`. prj orchestrates; the LOGIC lives in
# the named repo (the app). The CALLER resolves the workspace (by env) first; the hook runs
# from the owner repo's dir with $ADF_WORKSPACE exported and all extra args forwarded.
run_catalog_hook() {
  local name="$1"; shift
  local lock="$WORKSPACE_ROOT/knowledge/deployment/catalog/graph.lock"
  [[ -f "$lock" ]] || { err "$name: no catalog (knowledge/deployment/catalog/graph.lock) in this workspace."; return 1; }
  # Resolve hooks.<name> → "<repo-leaf>|<cmd>" (repo dir = sibling of the workspace).
  local spec
  spec="$(python3 -c "
import json,sys
c=json.load(open('$lock'))
h=(c.get('hooks') or {}).get('$name')
if not h or not h.get('cmd'): sys.exit(1)
print((h.get('repo') or '')+'|'+h['cmd'])
" 2>/dev/null)" || { err "$name: no '$name' hook declared in the catalog (hooks.$name)."; return 1; }
  local repo="${spec%%|*}" cmd="${spec#*|}"
  [[ -n "$repo" ]] || { err "$name: hook '$name' declares no owner repo."; return 1; }
  # Materialize the owner repo on demand (#109) — the hook's logic lives in a
  # member repo that may not be cloned into the project (shared libs never are).
  # local → worktree of the project branch (reusing a cloned-in sibling);
  # dev/uat/prod → worktree of the env code branch in the per-env folder. The
  # repo is fetched/reset to upstream first, so the answer reflects live source.
  local env="${RESOLVED_ENV:-local}" repo_dir
  repo_dir="$("$SCRIPTS/deploy/materialize-repo.sh" "$repo" "$env" "$WORKSPACE_ROOT")" \
    || { err "$name: could not materialize owner repo '$repo' for env=$env."; return 1; }
  [[ -n "$repo_dir" && -d "$repo_dir" ]] || { err "$name: materialized repo dir invalid ('$repo_dir')."; return 1; }
  export ADF_WORKSPACE="$WORKSPACE_ROOT"
  # Forward all extra args, shell-quoted so values with spaces survive the eval.
  local q="" a
  for a in "$@"; do q+=" $(printf '%q' "$a")"; done
  ( cd "$repo_dir" && eval "$cmd$q" )
}

# `prj seed [--env <env>] <args>` — run the catalog `seed` hook against the right workspace.
# env from --env (default local): local → WIP project; dev/uat/prod → gov repo (main).
cmd_seed() {
  local env="local" a prev=""
  for a in "$@"; do [[ "$prev" == "--env" ]] && env="$a"; prev="$a"; done
  resolve_workspace "$env" || return 1
  run_catalog_hook seed "$@"
}

# ── Data — query a unit's datastore (generic over data-capable units) ─────────
# `prj data` (or `--list`) enumerates the data-capable units (catalog hooks named
# `<unit>-data`); `prj data <unit> <env> …` dispatches to that unit's data hook.
# The unit's hook (e.g. svm-ident's iam-data.sh) provides the actual surface:
# --list / --describe / <query-name> [k=v…] / --tables / "<SQL>" / interactive shell.
# `prj iam-data` remains as an alias for `prj data iam`.
# Interactively gather a unit's DECLARED facts and write a JSON spec; echo its path.
# Env-agnostic by design: a unit is defined ONCE for ALL envs (only its deploy pin
# is per-env). Derived facts (paths/depends_on/artifact) are NEVER prompted.
_catalog_authoring_spec() {
  local name="$1" REPO ANCHOR KIND REQ HDEV HUAT HPROD EDGE HC SERVE
  ask REPO   "Repo (owner/name)"
  ask ANCHOR "Buildable package path (anchor) — blank = declared-only" ""
  if [[ -z "$ANCHOR" ]]; then ask KIND "kind (api | spa | lib)"; else ask KIND "kind override (blank = inferred)" ""; fi
  ask REQ    "requires — comma-separated platform services / units (blank = none)" ""
  ask HDEV   "host in dev (blank = not in dev)"  ""
  ask HUAT   "host in uat (blank = not in uat)"  ""
  ask HPROD  "host in prod (blank = not in prod)" ""
  ask EDGE   "edge (e.g. ${name}-<env>.svayamtech.com, blank = none)" ""
  ask HC     "healthcheck path" "/health"
  ask SERVE  "serve entry (spa/local serve, blank = none)" ""
  local spec; spec="$(mktemp)"
  NAME="$name" REPO="$REPO" ANCHOR="$ANCHOR" KIND="$KIND" REQ="$REQ" \
  HDEV="$HDEV" HUAT="$HUAT" HPROD="$HPROD" EDGE="$EDGE" HC="$HC" SERVE="$SERVE" \
  python3 - "$spec" <<'PY'
import os, json, sys
def lst(s): return [x.strip() for x in s.split(',') if x.strip()]
hosts = {k: v for k, v in (("dev", os.environ["HDEV"]), ("uat", os.environ["HUAT"]), ("prod", os.environ["HPROD"])) if v}
spec = {"name": os.environ["NAME"], "repo": os.environ["REPO"]}
if os.environ["ANCHOR"]: spec["anchor"] = os.environ["ANCHOR"]
if os.environ["KIND"]:   spec["kind"] = os.environ["KIND"]
if os.environ["REQ"]:    spec["requires"] = lst(os.environ["REQ"])
if hosts:                spec["hosts"] = hosts
if os.environ["EDGE"]:   spec["edge"] = os.environ["EDGE"]
if os.environ["SERVE"]:  spec["serve"] = os.environ["SERVE"]
spec["healthcheck"] = os.environ["HC"]
json.dump(spec, open(sys.argv[1], "w"))
PY
  echo "$spec"
}

# `prj catalog <env>` — discover the units in the deploy catalog FOR AN ENV: per-env host,
# DEPLOYED (pinned) version, and resolved edge. Env is REQUIRED — the catalog's meaningful
# view (hosts, pins) is per-env. dev/uat/prod read the gov repo (committed main); local
# reads the WIP project.
cmd_catalog() {
  case "${1:-}" in
    -h|--help) cmd_help catalog; return 0 ;;
    build|check)
      # Authoring ops: (re)derive graph.lock from services.yaml + the member repos (build),
      # or drift-gate it (check). WIP → the PROJECT workspace. Extra args forwarded.
      local action="$1"; shift
      resolve_workspace local || return 1
      # Derivation needs the member repos' source — materialize any that aren't
      # cloned into the project on demand (#109) rather than failing.
      CATALOG_MATERIALIZE=1 CATALOG_ENV=local \
        exec python3 "$SCRIPTS/deploy/catalog.py" "$action" "$@"
      ;;
    dag)
      # Derived DAG, live. Topology is env-invariant; --env <env> decorates with
      # host/pin/edge/endpoints for that env (so env is OPTIONAL here).
      shift
      local denv="local" _i _args=("$@")
      for ((_i=0; _i<${#_args[@]}; _i++)); do [[ "${_args[$_i]}" == "--env" ]] && denv="${_args[$((_i+1))]}"; done
      resolve_workspace "$denv" || return 1
      exec python3 "$SCRIPTS/deploy/catalog.py" dag "$@"
      ;;
    add)
      # Define a NEW unit — interactive, env-agnostic (one entry, all envs). PROPOSES
      # a services.yaml block (POL-086-safe: place it under `services:`; graduates at close).
      shift
      local name="${1:-}"; [[ -n "$name" ]] || ask name "Unit name (spans all envs — NOT per-env)"
      header "Add catalog unit — $name"
      label "Defined ONCE for ALL envs. Only the deploy PIN promotes dev→uat→prod (prj deploy <unit> --<env>)."
      echo ""
      resolve_workspace local || return 1
      local spec; spec="$(_catalog_authoring_spec "$name")"
      echo ""
      python3 "$SCRIPTS/deploy/catalog.py" add --spec "$spec"
      rm -f "$spec"
      ;;
    update)
      shift
      local name="${1:-}"; [[ -n "$name" ]] || { err "usage: prj catalog update <unit>"; return 1; }
      header "Update catalog unit — $name"
      echo ""
      resolve_workspace local || return 1
      local spec; spec="$(_catalog_authoring_spec "$name")"
      echo ""
      python3 "$SCRIPTS/deploy/catalog.py" update "$name" --spec "$spec"
      rm -f "$spec"
      ;;
    rm)
      shift
      local name="${1:-}"; [[ -n "$name" ]] || { err "usage: prj catalog rm <unit>"; return 1; }
      resolve_workspace local || return 1
      python3 "$SCRIPTS/deploy/catalog.py" rm "$name"
      return $?
      ;;
  esac
  local env="${1:-}"
  [[ -n "$env" ]] || { err "usage: prj catalog <local|dev|uat|prod>  (env view; env required)
       subcommands: prj catalog <dag|add|update|rm|build|check> …"; return 1; }
  case "$env" in
    local|dev|uat|prod) ;;
    *) err "catalog: '$env' is not an env or subcommand (note: subcommand comes FIRST, e.g. 'prj catalog dag $env').
       env view:    prj catalog <local|dev|uat|prod>
       subcommands: prj catalog dag [<unit|app|service>] [--env <env>] | add [<unit>] | update <unit> | rm <unit> | build | check"; return 1 ;;
  esac
  # local → WIP project; dev/uat/prod → gov repo (committed main).
  resolve_workspace "$env" || return 1
  local cd="$WORKSPACE_ROOT/knowledge/deployment/catalog"
  [[ -f "$cd/graph.lock" ]] || { err "no catalog at $cd/graph.lock"; return 1; }
  python3 - "$cd/graph.lock" "$cd/pins.yaml" "$env" <<'PY'
import json, sys
try: import yaml
except Exception: yaml = None
_t=sys.stdout.isatty(); B='\033[1m' if _t else ''; D='\033[2m' if _t else ''; N='\033[0m' if _t else ''
lock=json.load(open(sys.argv[1])); pins={}
if yaml:
    try: pins=(yaml.safe_load(open(sys.argv[2])) or {}).get('pins',{}) or {}
    except Exception: pins={}
env=sys.argv[3]
units=lock.get('units',{}) or {}; apps=lock.get('applications',{}) or {}; ps=(lock.get('external') or lock.get('platform_services') or {})
epins=pins.get(env,{}) or {}
print()
if apps:
    print(B+"Applications"+N+D+"  (env=%s)"%env+N)
    for a,info in sorted(apps.items()):
        print("  %-12s -> %s" % (a, ", ".join(info.get('members') or [])))
    print()
print(B+"Units"+N+D+"  (env=%s)"%env+N)
print(D+"  %-13s %-5s %-10s %-10s %s"%("unit","kind","host","deployed","edge")+N)
for u in sorted(units):
    d=units[u]; host=(d.get('hosts') or {}).get(env) or '-'
    pin=epins.get(u) or '-'
    if env == 'local':
        # local isn't a public domain — a SERVED unit runs on localhost at its
        # stable assigned port (#108.3, lock local_port). Non-served units (libs)
        # have NO endpoint → '-'.
        port=d.get('local_port')
        edge=('localhost:%s'%port) if port else '-'
        # a served unit runs ON localhost in local — default the host when not declared.
        if host=='-' and port: host='localhost'
    else:
        edge=(d.get('edge') or '').replace('<env>',env) or '-'
    print("  %-13s %-5s %-10s %-10s %s"%(u, d.get('kind') or '', host, pin, edge))
print(D+"  deployed = pinned version in '%s'  (- = not deployed there)"%env+N)
print()
if ps:
    print(B+"External"+N+D+"  (env=%s)  — consumed, not deployed by us"%env+N)
    print(D+"  %-15s %-8s %s"%("dep","sub_type","endpoint")+N)
    for n in sorted(ps):
        x=ps[n]; ep=(x.get('endpoints') or {}).get(env) or (x.get('hosts') or {}).get(env) or '-'
        print("  %-15s %-8s %s"%(n, x.get('sub_type') or x.get('type') or '', ep))
print()
PY
}

# `prj data --list <env>`             list the data-capable units (for an env)
# `prj data <unit> <env> [args…]`     query a unit's datastore — env-aware workspace:
#   local       → the PROJECT workspace (projects-folder + selected project; cwd/picker)
#   dev/uat/prod→ the gov repo ($ADF_WORKSPACE, always on main; committed catalog)
cmd_data() {
  case "${1:-}" in
    -h|--help) cmd_help data; return 0 ;;
    "") err "usage: prj data --list <env>  |  prj data <unit> <env> [<query> k=v | --list | --describe <name> | --tables | \"<SQL>\"]"; return 1 ;;
  esac
  if [[ "$1" == "--list" || "$1" == "-l" || "$1" == "list" ]]; then
    local env="${2:-}"
    [[ -n "$env" ]] || { err "env required: prj data --list <local|dev|uat|prod>"; return 1; }
    case "$env" in local|dev|uat|prod) ;; *) err "env must be local|dev|uat|prod"; return 1 ;; esac
    resolve_workspace "$env" || return 1
    local lock="$WORKSPACE_ROOT/knowledge/deployment/catalog/graph.lock"
    echo ""
    echo -e "${BOLD}Data-capable units${NC}${DIM}  (env=$env)${NC}"
    python3 - "$lock" "$env" <<'PY'
import json, sys
_t=sys.stdout.isatty(); D='\033[2m' if _t else ''; N='\033[0m' if _t else ''
c=json.load(open(sys.argv[1])); env=sys.argv[2]; hooks=c.get('hooks') or {}
rows=[(k[:-5],(v.get('repo') or '').split('/')[-1]) for k,v in sorted(hooks.items()) if k.endswith('-data') and v.get('cmd')]
if not rows: print('  (none — no <unit>-data hooks declared)')
else:
    print(D+'  %-10s %-26s %s'%('unit','owner repo','try')+N)
    for name,repo in rows:
        print('  %-10s %-26s prj data %s %s --list'%(name,repo,name,env))
PY
    echo ""
    return 0
  fi
  local unit="$1" env="${2:-}"; shift
  [[ -n "$env" ]] || { err "usage: prj data $unit <env> [<query> k=v | --list | --describe <name> | --tables]  (env required)"; return 1; }
  # Env-keyed workspace: local = the WIP project (working tree); dev/uat/prod = gov (main).
  resolve_workspace "$env" || return 1
  local lock="$WORKSPACE_ROOT/knowledge/deployment/catalog/graph.lock"
  if [[ -f "$lock" ]] && ! python3 -c "import json,sys; sys.exit(0 if (json.load(open('$lock')).get('hooks') or {}).get('${unit}-data',{}).get('cmd') else 1)" 2>/dev/null; then
    err "no data hook for unit '$unit'. Run 'prj data --list $env' to see data-capable units."
    return 1
  fi
  run_catalog_hook "${unit}-data" "$@"
}

