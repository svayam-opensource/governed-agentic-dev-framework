repos = [r for r in (c.get('repos') or []) if r and r.get('url')]
if repos:
    print(f"  {BOLD}Repos ({len(repos)}):{NC}")
    for r in repos:
        print(f"    {DIM}•{NC} {r['url']}  {DIM}[{r.get('role','?')} / base: {r.get('base_branch','?')}]{NC}")
