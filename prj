# ── Manage: Policy Owner assignment commands ──────────────────────────────────

check_policy_owner() {
  if [[ -z "$POLICY_OWNER_EMAIL" || "$CURRENT_USER" == "$POLICY_OWNER_EMAIL" ]]; then
    return 0
  fi
  echo ""
  warn "This section is intended for the Policy Owner (${POLICY_OWNER_EMAIL})."
  warn "You are currently identified as: ${CURRENT_USER:-unknown}"
  echo ""
  confirm "Continue anyway?"
}

# Fetch GitHub org members and teams; print one candidate per line
fetch_gh_assignees() {
  local owner="${1:-$GITHUB_ORG}"
  local candidates=()

  # Org members
  local members
  members=$(gh api "/orgs/${owner}/members" --jq '.[].login' 2>/dev/null) || members=""
  while IFS= read -r m; do [[ -n "$m" ]] && candidates+=("$m"); done <<< "$members"

  # Org teams (prefixed so they're visually distinct)
  local teams
  teams=$(gh api "/orgs/${owner}/teams" --jq '.[].slug' 2>/dev/null) || teams=""
  while IFS= read -r t; do [[ -n "$t" ]] && candidates+=("@${t}"); done <<< "$teams"

  if [[ ${#candidates[@]} -eq 0 ]]; then
    return 1
  fi
  printf '%s\n' "${candidates[@]}"
}

# Derive branch name from project_id (SVM-001-slug → svm-001-slug)
project_branch() {
  echo "$1" | tr '[:upper:]' '[:lower:]'
}

# Write assignment fields to project.yaml and commit to the right branch
commit_assignment() {
  local project_id="$1"
  local pf="$SCRIPT_DIR/projects/$project_id/project.yaml"
  local status branch

  status=$(python3 -c "import yaml; print(yaml.safe_load(open('$pf')).get('status',''))" 2>/dev/null || echo "")
  branch=$(project_branch "$project_id")

  cd "$SCRIPT_DIR"
  case "$status" in
    active|paused)
      git checkout "$branch" 2>/dev/null || true
      git add "projects/$project_id/project.yaml"
      git commit -m "manage: update assignment for $project_id"
      git push origin "$branch"
      git checkout "$DEFAULT_BRANCH" 2>/dev/null || true
      ;;
    *)
      git checkout "$DEFAULT_BRANCH"
      git pull origin "$DEFAULT_BRANCH" 2>/dev/null || true
      git add "projects/$project_id/project.yaml"
      git commit -m "manage: update assignment for $project_id"
      git push origin "$DEFAULT_BRANCH"
      ;;
  esac
}

# Select a project and show its current assignee
select_project_managed() {
  local __var="$1"; shift
  local __filters=("$@")

  local __projects
  __projects=$(python3 - "$REGISTRY" "$SCRIPT_DIR" "${__filters[@]:-}" <<'PY'
import sys, os, yaml
registry, proj_dir = sys.argv[1], sys.argv[2]
filters = sys.argv[3:]
c = yaml.safe_load(open(registry))
for p in (c.get('projects') or []):
    if not p: continue
    if filters and p.get('status') not in filters: continue
    pf = os.path.join(proj_dir, 'projects', p['id'], 'project.yaml')
    assignee = ''
    if os.path.exists(pf):
        pc = yaml.safe_load(open(pf))
        assignee = pc.get('assigned_to') or ''
    print(f"{p['id']}|{p.get('status','?')}|{assignee}")
PY
)

  [[ -n "$__projects" ]] || { err "No matching projects found."; exit 1; }

  local __ids=() __statuses=() __assignees=()
  while IFS='|' read -r id status assignee; do
    __ids+=("$id"); __statuses+=("$status"); __assignees+=("$assignee")
  done <<< "$__projects"

  echo -e "${BOLD}Select project:${NC}"
  local i
  for i in "${!__ids[@]}"; do
    local adisp="${__assignees[$i]:-${DIM}unassigned${NC}}"
    printf "  ${CYAN}%d)${NC} %-40s ${DIM}%s${NC}  %s\n" \
      $((i+1)) "${__ids[$i]}" "${__statuses[$i]}" "$adisp"
  done

  local __choice
  while true; do
    printf "Choose [1-%d]: " "${#__ids[@]}"
    read -r __choice
    if [[ "$__choice" =~ ^[0-9]+$ ]] && (( __choice >= 1 && __choice <= ${#__ids[@]} )); then
      printf -v "$__var" '%s' "${__ids[$((__choice-1))]}"
      return
    fi
    err "Invalid choice."
  done
}

# Pick an assignee from org members/teams or enter manually
select_assignee() {
  local __var="$1" __owner="${2:-$GITHUB_ORG}"
  local candidates=()

  label "Fetching org members and teams from ${__owner}..."
  while IFS= read -r c; do [[ -n "$c" ]] && candidates+=("$c"); done \
    < <(fetch_gh_assignees "$__owner" 2>/dev/null)

  if [[ ${#candidates[@]} -eq 0 ]]; then
    warn "Could not fetch org members (may not be an org, or insufficient permissions)."
    ask "$__var" "Assignee (GitHub username, email, or @team-slug)"
    return
  fi

  candidates+=("— enter manually —")
  echo ""
  echo -e "${BOLD}Select assignee:${NC}"
  local i
  for i in "${!candidates[@]}"; do
    printf "  ${CYAN}%d)${NC} %s\n" $((i+1)) "${candidates[$i]}"
  done

  local __choice
  while true; do
    printf "Choose [1-%d]: " "${#candidates[@]}"
    read -r __choice
    if [[ "$__choice" =~ ^[0-9]+$ ]] && (( __choice >= 1 && __choice <= ${#candidates[@]} )); then
      local picked="${candidates[$((__choice-1))]}"
      if [[ "$picked" == "— enter manually —" ]]; then
        ask "$__var" "Assignee (GitHub username, email, or @team-slug)"
      else
        printf -v "$__var" '%s' "$picked"
      fi
      return
    fi
    err "Invalid choice."
  done
}

cmd_manage_list() {
  header "Project Assignments"
  divider
  echo ""
  python3 - "$REGISTRY" "$SCRIPT_DIR" <<'PY'
import sys, os, yaml
registry, proj_dir = sys.argv[1], sys.argv[2]
BOLD='\033[1m'; NC='\033[0m'; DIM='\033[2m'
GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; RED='\033[0;31m'
status_colour = {'active': GREEN, 'paused': YELLOW, 'completed': CYAN, 'cancelled': RED}
c = yaml.safe_load(open(registry))
projects = [p for p in (c.get('projects') or []) if p]
if not projects:
    print("  No projects found.")
    sys.exit(0)
print(f"  {BOLD}{'PROJECT':<40} {'STATUS':<12} ASSIGNED TO{NC}")
print(f"  {DIM}{'─'*40} {'─'*12} {'─'*30}{NC}")
for p in projects:
    pf = os.path.join(proj_dir, 'projects', p['id'], 'project.yaml')
    assignee = ''
    if os.path.exists(pf):
        pc = yaml.safe_load(open(pf))
        assignee = pc.get('assigned_to') or ''
    s = p.get('status', '?')
    sc = status_colour.get(s, '')
    adisp = assignee if assignee else f'{DIM}(unassigned){NC}'
    print(f"  {BOLD}{p['id']:<40}{NC} {sc}{s:<12}{NC} {adisp}")
print()
PY
}

cmd_manage_assign() {
  header "Assign Project"
  divider
  label "Assign an unassigned project to a GitHub user or team."
  echo ""
  select_project_managed PROJECT_ID "active" "paused"
  echo ""

  local pf="$SCRIPT_DIR/projects/$PROJECT_ID/project.yaml"
  local current_assignee
  current_assignee=$(python3 -c "import yaml; print(yaml.safe_load(open('$pf')).get('assigned_to') or '')" 2>/dev/null || echo "")

  if [[ -n "$current_assignee" ]]; then
    warn "'$PROJECT_ID' is already assigned to: $current_assignee"
    warn "Use 'reassign' to change an existing assignment (requires reason — C02)."
    echo ""
    return
  fi

  ask GH_OWNER "GitHub org or username for member lookup" "$GITHUB_ORG"
  select_assignee ASSIGNEE "$GH_OWNER"
  echo ""
  echo -e "  ${BOLD}Project:${NC}  $PROJECT_ID"
  echo -e "  ${BOLD}Assignee:${NC} $ASSIGNEE"
  echo ""
  confirm "Assign '$PROJECT_ID' to '$ASSIGNEE'?"

  python3 - "$pf" "$ASSIGNEE" <<'PY'
import sys, yaml
pf, assignee = sys.argv[1], sys.argv[2]
with open(pf) as f: c = yaml.safe_load(f)
c['assigned_to'] = assignee
c['locked_by']   = assignee
with open(pf, 'w') as f: yaml.dump(c, f, default_flow_style=False, allow_unicode=True, sort_keys=False)
PY

  commit_assignment "$PROJECT_ID"
  echo ""
  ok "'$PROJECT_ID' assigned to '$ASSIGNEE'."
}

cmd_manage_reassign() {
  header "Reassign Project"
  divider
  label "Reassign a project to a different user or team. Requires a reason (C02)."
  echo ""
  select_project_managed PROJECT_ID "active" "paused"
  echo ""

  local pf="$SCRIPT_DIR/projects/$PROJECT_ID/project.yaml"
  local current_assignee
  current_assignee=$(python3 -c "import yaml; print(yaml.safe_load(open('$pf')).get('assigned_to') or '')" 2>/dev/null || echo "")

  echo -e "  ${BOLD}Current assignee:${NC} ${current_assignee:-${DIM}(unassigned)${NC}}"
  echo ""

  ask GH_OWNER "GitHub org or username for member lookup" "$GITHUB_ORG"
  select_assignee NEW_ASSIGNEE "$GH_OWNER"
  echo ""

  # C02 — reassignment reason is mandatory
  ask REASON "Reassignment reason (C02 — required)"
  echo ""

  echo -e "  ${BOLD}Project:${NC}      $PROJECT_ID"
  echo -e "  ${BOLD}From:${NC}         ${current_assignee:-unassigned}"
  echo -e "  ${BOLD}To:${NC}           $NEW_ASSIGNEE"
  echo -e "  ${BOLD}Reason:${NC}       $REASON"
  echo -e "  ${BOLD}Approved by:${NC}  $CURRENT_USER"
  echo ""
  confirm "Reassign '$PROJECT_ID'?"

  local today
  today=$(date +%Y-%m-%d)

  python3 - "$pf" "$NEW_ASSIGNEE" "$REASON" "$CURRENT_USER" "$today" <<'PY'
import sys, yaml
pf, new_assignee, reason, approved_by, today = sys.argv[1:]
with open(pf) as f: c = yaml.safe_load(f)
c['assigned_to']            = new_assignee
c['locked_by']              = new_assignee
c['reassignment_reason']    = reason
c['reassigned_at']          = today
c['reassigned_approved_by'] = approved_by
with open(pf, 'w') as f: yaml.dump(c, f, default_flow_style=False, allow_unicode=True, sort_keys=False)
PY

  commit_assignment "$PROJECT_ID"
  echo ""
  ok "'$PROJECT_ID' reassigned to '$NEW_ASSIGNEE'."
  ok "C02 fields written: reassignment_reason, reassigned_at, reassigned_approved_by."
}

cmd_manage_unassign() {
  header "Unassign Project"
  divider
  label "Remove the current assignment, leaving the project unassigned."
  echo ""
  select_project_managed PROJECT_ID "active" "paused"
  echo ""

  local pf="$SCRIPT_DIR/projects/$PROJECT_ID/project.yaml"
  local current_assignee
  current_assignee=$(python3 -c "import yaml; print(yaml.safe_load(open('$pf')).get('assigned_to') or '')" 2>/dev/null || echo "")

  if [[ -z "$current_assignee" ]]; then
    warn "'$PROJECT_ID' is already unassigned."
    return
  fi

  echo -e "  ${BOLD}Current assignee:${NC} $current_assignee"
  echo ""
  confirm "Remove assignment from '$PROJECT_ID'?"

  python3 - "$pf" <<'PY'
import sys, yaml
with open(sys.argv[1]) as f: c = yaml.safe_load(f)
c['assigned_to'] = None
c['locked_by']   = None
with open(sys.argv[1], 'w') as f: yaml.dump(c, f, default_flow_style=False, allow_unicode=True, sort_keys=False)
PY

  commit_assignment "$PROJECT_ID"
  echo ""
  ok "'$PROJECT_ID' is now unassigned."
}

cmd_manage() {
  check_policy_owner
  header "Manage Assignments  ${DIM}(Policy Owner)${NC}"
  divider
  echo ""
  echo -e "  ${CYAN}1)${NC} list       List all projects and their assignments"
  echo -e "  ${CYAN}2)${NC} assign     Assign an unassigned project"
  echo -e "  ${CYAN}3)${NC} reassign   Reassign a project to a different user (C02)"
  echo -e "  ${CYAN}4)${NC} unassign   Remove assignment from a project"
  echo -e "  ${DIM}0)  Back${NC}"
  echo ""
  printf "  Choose: "
  read -r sub
  echo ""
  case "$sub" in
    1|list)      cmd_manage_list ;;
    2|assign)    cmd_manage_assign ;;
    3|reassign)  cmd_manage_reassign ;;
    4|unassign)  cmd_manage_unassign ;;
    0|back|"")   return ;;
    *)           err "Unknown option '$sub'." ;;
  esac
}

