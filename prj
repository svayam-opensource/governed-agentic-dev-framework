# select_from_owner_projects <id_var> <filter>
# filter: "unassigned" | "assigned"
# GitHub-derived (registry-elimination): ownership = the board's ANCHOR-issue
# assignees. A board WITH anchor assignees is 'assigned'; WITHOUT is 'unassigned'
# (incl. boards with no anchor yet = not seeded). The frozen shim only
# grandfathers legacy ids. Side-effects: sets GH_OWNER, MANAGE_SELECTED_URL,
# MANAGE_SELECTED_PID, MANAGE_SELECTED_NUM.
MANAGE_SELECTED_URL=""
MANAGE_SELECTED_PID=""
MANAGE_SELECTED_NUM=""
select_from_owner_projects() {
  local __var="$1" __filter="${2:-unassigned}"
  MANAGE_SELECTED_URL=""; MANAGE_SELECTED_PID=""; MANAGE_SELECTED_NUM=""

  ask GH_OWNER "GitHub org or username" "$GITHUB_ORG"
  echo ""
  label "Fetching GitHub Projects + ownership for ${GH_OWNER} (live)..."
  echo ""

  local __raw
  __raw=$(FILT="$__filter" python3 - "$REGISTRY" "$GH_OWNER" <<'PY'
import sys, os, re, json, subprocess, yaml
registry_path, owner = sys.argv[1], sys.argv[2]
filt = os.environ.get('FILT', 'unassigned')

shim = {}
try:
    c = yaml.safe_load(open(registry_path)) or {}
    for p in (c.get('projects') or []):
        if not p: continue
        m = re.search(r'/projects/(\d+)', p.get('github_project') or '')
        if m: shim[m.group(1)] = p
except Exception:
    pass
def slug(t): return re.sub(r'-+','-',re.sub(r'[^a-z0-9]','-',(t or '').lower())).strip('-')

q = '''query($o:String!){ organization(login:$o){ projectsV2(first:100){ nodes{
  number title closed
  items(first:50){ nodes{ content{ __typename
    ... on Issue { labels(first:10){nodes{name}} assignees(first:10){nodes{login}} } } } } } } } }'''
r = subprocess.run(['gh','api','graphql','-f','query='+q,'-F','o='+owner], capture_output=True, text=True)
if r.returncode != 0:
    sys.exit(0)
nodes = (json.loads(r.stdout).get('data',{}).get('organization',{}) or {}).get('projectsV2',{}).get('nodes',[]) or []
for nd in nodes:
    num = str(nd.get('number') or '')
    if not num: continue
    title = (nd.get('title') or '').replace('\t',' ')
    anchor = None
    for it in (nd.get('items',{}).get('nodes',[]) or []):
        cc = it.get('content') or {}
        if cc.get('__typename') != 'Issue': continue
        names = [l['name'] for l in (cc.get('labels',{}).get('nodes',[]) or [])]
        if 'anchor' in names:
            anchor = [a['login'] for a in (cc.get('assignees',{}).get('nodes',[]) or [])]
            break
    # Seeded = has an anchor OR is a grandfathered shim project (pre-anchor era).
    seeded = (anchor is not None) or (num in shim)
    assignee = ','.join(anchor or [])
    if filt == 'unassigned' and assignee: continue
    if filt == 'assigned' and not assignee: continue
    if seeded:
        pid = shim[num]['id'] if (num in shim and shim[num].get('id')) else ('PRJ-%s-%s' % (num, slug(title)))
    else:
        pid = ''
    url = 'https://github.com/orgs/%s/projects/%s' % (owner, num)
    print('%s\x1f%s\x1f%s\x1f%s\x1f%s' % (title, url, pid, num, assignee))
PY
  )

  if [[ -z "$__raw" ]]; then
    case "$__filter" in
      unassigned) err "No unassigned GitHub Projects found for '${GH_OWNER}'." ;;
      assigned)   err "No assigned projects found for '${GH_OWNER}'." ;;
      *)          err "No matching projects found." ;;
    esac
    exit 1
  fi

  local __titles=() __urls=() __pids=() __nums=() __assignees=()
  while IFS=$'\x1f' read -r title url pid num assignee; do
    [[ -z "$url" ]] && continue
    __titles+=("$title"); __urls+=("$url"); __pids+=("$pid")
    __nums+=("$num"); __assignees+=("$assignee")
  done <<< "$__raw"

  if [[ ${#__urls[@]} -eq 0 ]]; then
    err "No matching projects found."
    exit 1
  fi

  echo -e "${BOLD}Select project:${NC}"
  local i
  for i in "${!__urls[@]}"; do
    local _title="${__titles[$i]}"
    local _pid="${__pids[$i]}"
    local _asgn="${__assignees[$i]}"
    local _pd="${_pid:-(not seeded)}"
    local _ad="${_asgn:-(unassigned)}"
    if   [[ -n "$_pid" && -n "$_asgn" ]]; then
      printf "  ${CYAN}%d)${NC} %-38s %-24s %s\n"               $((i+1)) "$_title" "$_pd" "$_ad"
    elif [[ -n "$_pid" ]]; then
      printf "  ${CYAN}%d)${NC} %-38s %-24s ${DIM}%s${NC}\n"    $((i+1)) "$_title" "$_pd" "$_ad"
    else
      printf "  ${CYAN}%d)${NC} %-38s ${DIM}%-24s %s${NC}\n"    $((i+1)) "$_title" "$_pd" "$_ad"
    fi
  done

  local __choice
  while true; do
    printf "Choose [1-%d]: " "${#__urls[@]}"
    read -r __choice
    if [[ "$__choice" =~ ^[0-9]+$ ]] && (( __choice >= 1 && __choice <= ${#__urls[@]} )); then
      local __idx=$((__choice-1))
      printf -v "$__var" '%s' "${__pids[$__idx]}"
      MANAGE_SELECTED_URL="${__urls[$__idx]}"
      MANAGE_SELECTED_PID="${__pids[$__idx]}"
      MANAGE_SELECTED_NUM="${__nums[$__idx]}"
      return
    fi
    err "Invalid choice."
  done
}

