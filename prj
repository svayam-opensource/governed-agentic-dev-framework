      -F o="$owner" -F n="$num" --jq '.data.organization.projectV2.items.nodes[].content | select(.number) | "\(.repository.nameWithOwner)#\(.number)\t\(.title)"' 2>/dev/null)
  [[ ${#__refs[@]} -eq 0 ]] && { err "No issues on this board."; exit 1; }
