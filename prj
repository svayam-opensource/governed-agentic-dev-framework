# ── Deploy (polymorphic backend; PRJ-012 deploy design) ────────────────────────
# `prj deploy <target> --local|--dev|--uat|--prod [flags]`. ONE verb, backend by env:
#   --local            → scripts/deploy/serve-local.sh   (watch/serve + Tier-2 ladder)
#   --dev/--uat/--prod → scripts/deploy/jenkins.sh        (build-once-promote, remote)
# Env is REQUIRED (no default — guards against an accidental prod deploy). Provisioning
# is folded in via --provision (no separate verb). uat/prod confirm interactively unless
# --yes; full token-gating is tracked in svm-prj-work#86.
cmd_deploy() {
  local DEPLOY="$SCRIPTS/deploy"
  local target="" env="" action="up"
  local detach=0 image=0 dryrun=0 yes=0 provision=0 noprovision=0 seed=0 all=0 follow=0 skipapproval=0
  local pin="" branch="" agent="" config_dir="" register_app=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --local)              env="local" ;;
      --dev|--development)   env="development" ;;
      --uat|--staging)       env="staging" ;;
      --prod|--production)   env="production" ;;
      -d|--detach)           detach=1 ;;
      --image)               image=1 ;;
      --provision)           provision=1 ;;
      --no-provision)        noprovision=1 ;;   # opt out of local's auto-provision
      --seed)                seed=1 ;;          # also load curated data (implies provision)
      --dry-run|--plan)      dryrun=1 ;;
      -y|--yes)              yes=1 ;;
      -f|--follow)           follow=1 ;;
      --logs)                action="logs" ;;
      --stop)                action="stop" ;;
      --all)                 all=1 ;;            # with --stop: also bring down Tier-2 containers
      --skip-approval)       skipapproval=1 ;;
      --pin|--image-tag)     shift; pin="${1:-}" ;;
      --branch)              shift; branch="${1:-}" ;;
      --agent)               shift; agent="${1:-}" ;;
      --config-dir)          shift; config_dir="${1:-}" ;;
      --register-app)        shift; register_app="${1:-}" ;;
      -*)                    err "deploy: unknown flag '$1'"; return 1 ;;
      *) if [[ -z "$target" ]]; then target="$1"; else err "deploy: unexpected argument '$1'"; return 1; fi ;;
    esac
    shift
  done
  [[ -n "$target" ]] || { err "Usage: prj deploy <target> --local|--dev|--uat|--prod [flags]"; return 1; }
  [[ -n "$env" ]]    || { err "deploy: an environment is REQUIRED — exactly one of --local | --dev | --uat | --prod."; return 1; }

  # Provision policy: LOCAL auto-provisions (hermetic, disposable env — "deploy just works";
  # bootstrap reuses the volume, never wipes), opt out with --no-provision. Remote stays
  # explicit (--provision) so shared infra is never stood up silently. --seed needs the
  # substrate up + migrated, so it forces provision regardless.
  [[ "$env" == "local" && "$noprovision" == 0 ]] && provision=1
  [[ "$noprovision" == 1 ]] && provision=0
  [[ "$seed" == 1 ]] && provision=1

  export ADF_WORKSPACE="$WORKSPACE_ROOT"   # the deploy backends resolve the catalog/repos from this

  # ── LOCAL: serve-local.sh (watch/serve orchestrator) ──────────────────────────
  if [[ "$env" == "local" ]]; then
    # Local reads the developer's WORKING TREE, so the workspace must be the CURRENT
    # project — not a globally-pinned $ADF_WORKSPACE (which suits dev/uat/prod where the
    # canonical catalog lives on main). Resolve from cwd, else prompt to choose a project.
    local _lws; _lws="$(resolve_local_workspace)" || return 1
    export ADF_WORKSPACE="$_lws"
    info "local workspace: $_lws"
    local args=("$target")
    [[ "$action" == "stop" ]] && args+=(--stop)
    [[ "$all"    == 1 ]]      && args+=(--all)
    [[ "$action" == "logs" ]] && args+=(--logs)
    [[ "$detach"   == 1 ]]    && args+=(-d)
    [[ "$image"    == 1 ]]    && args+=(--image)
    [[ "$provision" == 1 ]]   && args+=(--provision)
    [[ "$seed"     == 1 ]]    && args+=(--seed)
    if [[ "$dryrun" == 1 ]]; then
      info "DRY-RUN (local): bash $DEPLOY/serve-local.sh ${args[*]}"
      python3 "$DEPLOY/catalog.py" resolve "$target" --env local 2>/dev/null || true
      return 0
    fi
    exec bash "$DEPLOY/serve-local.sh" "${args[@]}"
  fi

  # ── REMOTE (dev/uat/prod): trigger the Jenkins deploy job per built unit ───────
  [[ "$seed" == 1 ]] && warn "deploy: --seed is local-only for now (the seed hook targets the local DB); seed remote envs separately once the seed hook supports them."
  local suffix; case "$env" in development) suffix="dev";; staging) suffix="uat";; production) suffix="prod";; esac
  local units
  units=$(python3 "$DEPLOY/catalog.py" resolve "$target" --env "$env" --format json 2>/dev/null \
    | python3 -c 'import sys,json
try:
    ms=json.load(sys.stdin)
except Exception:
    ms=[]
print("\n".join(m["service"] for m in ms if m.get("kind") in ("api","spa")))' 2>/dev/null)
  [[ -n "$units" ]] || units="$target"

  # Interim safety (svm-prj-work#86): confirm uat/prod unless --yes.
  if [[ "$env" == "staging" || "$env" == "production" ]] && [[ "$yes" != 1 ]]; then
    warn "Deploying '$target' to ${env^^} — units: $(echo "$units" | tr '\n' ' ')"
    warn "Token-gated authorization is tracked in svm-prj-work#86; for now confirm interactively."
    printf "  Type '%s' to proceed: " "$suffix"
    read -r confirm
    [[ "$confirm" == "$suffix" || "$confirm" == "$env" ]] || { err "Confirmation mismatch — aborted."; return 1; }
  fi

  local u rc=0
  for u in $units; do
    local job="deploy/${u}/${suffix}"
    local params=("DEPLOY_ENV=$env")
    [[ -n "$agent" ]]        && params+=("AGENT_LABEL=$agent")
    [[ -n "$pin" ]]          && params+=("IMAGE_TAG_OVERRIDE=$pin")
    [[ -n "$branch" ]]       && params+=("BUILD_BRANCH=$branch" "PORTAL_BRANCH=$branch")  # unit-specific; Jenkins ignores undeclared
    [[ -n "$config_dir" ]]   && params+=("IAM_DEPLOY_DIR=$config_dir")
    [[ -n "$register_app" ]] && params+=("REGISTER_APP_SPEC=$register_app")
    [[ "$skipapproval" == 1 ]] && params+=("SKIP_PROD_APPROVAL=true")
    if [[ "$dryrun" == 1 ]]; then
      info "DRY-RUN (remote): bash $DEPLOY/jenkins.sh $([[ $follow == 1 ]] && echo run || echo trigger) $job ${params[*]}"
      continue
    fi
    info "deploy: $job  (${params[*]})"
    if [[ "$follow" == 1 ]]; then
      bash "$DEPLOY/jenkins.sh" run "$job" "${params[@]}" || rc=$?
    else
      bash "$DEPLOY/jenkins.sh" trigger "$job" "${params[@]}" || rc=$?
    fi
  done
  return $rc
}

# ── Local workspace resolution (PRJ-012) ───────────────────────────────────────
# For LOCAL deploys the workspace = the CURRENT project (devs iterate on their own
# tree), NOT a globally-pinned $ADF_WORKSPACE. Resolve from cwd (nearest org-config.yaml);
# if not inside a project, prompt to choose one from $AGENT_WORK_ROOT. Echoes the path.
resolve_local_workspace() {
  local d="$PWD"
  while [[ "$d" != "/" ]]; do
    [[ -f "$d/org-config.yaml" ]] && { echo "$d"; return 0; }
    d="$(dirname "$d")"
  done
  # Not inside a project — enumerate $AGENT_WORK_ROOT/<project>/<WORKSPACE_REPO>.
  local -a ws=() labels=(); local p
  for p in "$AGENT_WORK_ROOT"/*/"$WORKSPACE_REPO"/org-config.yaml; do
    [[ -f "$p" ]] || continue
    ws+=("$(dirname "$p")"); labels+=("$(basename "$(dirname "$(dirname "$p")")")")
  done
  [[ ${#ws[@]} -gt 0 ]] || { err "no projects under $AGENT_WORK_ROOT — cd into a project or set ADF_WORKSPACE." ; return 1; }
  if [[ ${#ws[@]} -eq 1 ]]; then echo "${ws[0]}"; return 0; fi
  echo "Select the project to deploy locally:" >&2
  local i; for i in "${!ws[@]}"; do printf "  %d) %s\n" "$((i+1))" "${labels[$i]}" >&2; done
  printf "  Choice [1]: " >&2; local c; read -r c; c="${c:-1}"
  local idx=$((c-1)); [[ $idx -ge 0 && $idx -lt ${#ws[@]} ]] || { err "invalid choice"; return 1; }
  echo "${ws[$idx]}"
}

# ── Catalog hooks (PRJ-012) — generic verb → app-owned script dispatch ──────────
# The catalog declares `hooks.<name> = { repo, cmd }`. prj orchestrates; the LOGIC
# lives in the named repo (the app), not here — so app-specific tooling (e.g. IAM
# seed / data) is invoked via a generic verb without shipping app internals in the
# open-source CLI. The hook runs from the owner repo's dir with $ADF_WORKSPACE
# exported and all extra args forwarded. Mirrors how deploy uses catalog provision.
run_catalog_hook() {
  local name="$1"; shift
  local lock="$WORKSPACE_ROOT/knowledge/deployment/catalog/graph.lock"
  [[ -f "$lock" ]] || { err "$name: no catalog (knowledge/deployment/catalog/graph.lock) in this workspace."; return 1; }
  # Resolve hooks.<name> → "<repo-leaf>|<cmd>" (repo dir = sibling of the workspace).
  local spec
  spec="$(python3 -c "
import json,sys
c=json.load(open('$lock'))
h=(c.get('hooks') or {}).get('$name')
if not h or not h.get('cmd'): sys.exit(1)
repo=(h.get('repo') or '').split('/')[-1]
print(repo+'|'+h['cmd'])
" 2>/dev/null)" || { err "$name: no '$name' hook declared in the catalog (hooks.$name)."; return 1; }
  local leaf="${spec%%|*}" cmd="${spec#*|}"
  local repo_dir; repo_dir="$(cd "$WORKSPACE_ROOT/.." && pwd)/$leaf"
  [[ -d "$repo_dir" ]] || { err "$name: owner repo '$leaf' not found at $repo_dir (clone it into the project)."; return 1; }
  export ADF_WORKSPACE="$WORKSPACE_ROOT"
  # Forward all extra args, shell-quoted so values with spaces survive the eval.
  local q="" a
  for a in "$@"; do q+=" $(printf '%q' "$a")"; done
  ( cd "$repo_dir" && eval "$cmd$q" )
}

