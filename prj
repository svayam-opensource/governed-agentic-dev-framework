print(f"  {BOLD}{'GITHUB PROJECT':<38} {'SEEDED AS':<22} {'STATUS':<12} OWNERS{NC}")
print(f"  {DIM}{'─'*38} {'─'*22} {'─'*12} {'─'*25}{NC}")

rows = []
for nd in nodes:
    num = str(nd.get('number') or '')
    if not num: continue
    title = (nd.get('title') or '(untitled)')
    closed = bool(nd.get('closed'))
    anchor = None
    for it in (nd.get('items',{}).get('nodes',[]) or []):
        cc = it.get('content') or {}
        if cc.get('__typename') != 'Issue': continue
        names = [l['name'] for l in (cc.get('labels',{}).get('nodes',[]) or [])]
        if 'anchor' in names:
            anchor = {'labels': names, 'assignees': [a['login'] for a in (cc.get('assignees',{}).get('nodes',[]) or [])]}
            break
    # Seeded = has an anchor OR is a grandfathered shim project (pre-anchor era).
    seeded = (anchor is not None) or (num in shim)
    if not seeded:
        status = 'not-initiated'; pid = '(not seeded)'; owners = ''
    else:
        labels = anchor['labels'] if anchor else []
        status = ('cancelled' if 'cancelled' in labels else 'completed') if closed \
                 else ('paused' if 'paused' in labels else 'active')
        pid = shim[num]['id'] if (num in shim and shim[num].get('id')) else 'PRJ-%s-%s' % (num, slug(title))
        owners = ', '.join(anchor['assignees']) if anchor else ''
    rows.append((int(num), title[:36], pid, status, owners))

for _, title, pid, status, owners in sorted(rows, key=lambda r: r[0], reverse=True):
    sc = status_colour.get(status, DIM)
    adisp = owners if owners else f'{DIM}(unassigned){NC}'
    pidc = BOLD if pid != '(not seeded)' else DIM
    print(f"  {title:<38} {pidc}{pid:<22}{NC} {sc}{status:<12}{NC} {adisp}")
print()
PY
}

# manage_apply_owner <add|remove> <board_number> <project_url> <assignee>
# GitHub-SoT ownership change (registry-elimination): for a USER login, set the
# anchor-issue assignee (if the board has an anchor) AND board write access; for
# a @team, board write access only (issues can't be assigned to teams). No
# registry/pre_assignments write.
manage_apply_owner() {
  local action="$1" num="$2" url="$3" who="$4" pa ref
  [[ "$action" == "add" ]] && pa="grant" || pa="revoke"
  if [[ "$who" == @* ]]; then
    bash "$SCRIPTS/project-access.sh" "$pa" "$url" "$who" \
      || warn "Could not $pa board access for team '$who'."
    return 0
  fi
  ref="$(anchor_issue_ref "$num" "$GH_OWNER")"
  if [[ -n "$ref" ]]; then
    gh issue edit "${ref##*#}" --repo "${ref%%#*}" "--${action}-assignee" "$who" >/dev/null 2>&1 \
      || warn "Could not ${action} anchor assignee '$who' on $ref."
  fi
  bash "$SCRIPTS/project-access.sh" "$pa" "$url" "$who" \
    || warn "Could not $pa board access for '$who'."
}

cmd_manage_assign() {
  header "Assign Project"
  divider
  label "Assign an unassigned project to a GitHub user or team."
  echo ""
  select_from_owner_projects PROJECT_ID "unassigned"
  echo ""

  select_assignee ASSIGNEE "$GH_OWNER"
  echo ""

  local label_proj="${MANAGE_SELECTED_PID:-$MANAGE_SELECTED_URL}"
  echo -e "  ${BOLD}Project:${NC}  $label_proj"
  echo -e "  ${BOLD}Assignee:${NC} $ASSIGNEE"
  echo ""
  confirm "Assign this project to '$ASSIGNEE'?"
  echo ""

  # Ownership = anchor-issue assignee + board write access (GitHub-SoT). The
  # registry/pre_assignments cache is gone. For not-yet-seeded boards (no anchor)
  # this grants board access only; the seeder becomes the anchor owner at seed.
  manage_apply_owner add "$MANAGE_SELECTED_NUM" "$MANAGE_SELECTED_URL" "$ASSIGNEE"
  echo ""
  if [[ -n "$MANAGE_SELECTED_PID" ]]; then
    ok "'$MANAGE_SELECTED_PID' assigned to '$ASSIGNEE' (anchor assignee + board access)."
  else
    ok "Board granted to '$ASSIGNEE' (board access). They may now run './prj init' to seed it."
  fi
}

cmd_manage_reassign() {
  header "Reassign Project"
  divider
  label "Reassign a project to a different user or team. Requires a reason (C02)."
  echo ""
  select_from_owner_projects PROJECT_ID "assigned"
  echo ""

  local current_assignee=""
  current_assignee="$(project_owners "$MANAGE_SELECTED_NUM" "$GH_OWNER" | paste -sd ',' -)"

  echo -e "  ${BOLD}Current assignee:${NC} ${current_assignee:-${DIM}(unassigned)${NC}}"
  echo ""

  select_assignee NEW_ASSIGNEE "$GH_OWNER"
  echo ""

  ask REASON "Reassignment reason (C02 — required)"
  echo ""

  local today
  today=$(date +%Y-%m-%d)
  local label_proj="${MANAGE_SELECTED_PID:-$MANAGE_SELECTED_URL}"

  echo -e "  ${BOLD}Project:${NC}      $label_proj"
  echo -e "  ${BOLD}From:${NC}         ${current_assignee:-unassigned}"
  echo -e "  ${BOLD}To:${NC}           $NEW_ASSIGNEE"
  echo -e "  ${BOLD}Reason:${NC}       $REASON"
  echo -e "  ${BOLD}Approved by:${NC}  $CURRENT_USER"
  echo ""
  confirm "Reassign this project?"
  echo ""

  # Move ownership: remove each current owner, add the new one (anchor assignee +
  # board access). GitHub-SoT — no registry write.
  local _o
  if [[ -n "$current_assignee" ]]; then
    IFS=',' read -ra _olist <<< "$current_assignee"
    for _o in "${_olist[@]}"; do
      [[ -n "$_o" ]] && manage_apply_owner remove "$MANAGE_SELECTED_NUM" "$MANAGE_SELECTED_URL" "$_o"
    done
  fi
  manage_apply_owner add "$MANAGE_SELECTED_NUM" "$MANAGE_SELECTED_URL" "$NEW_ASSIGNEE"

  # C02 audit trail → a structured comment on the anchor issue (audit lives in
  # GitHub next to ownership; no registry history).
  local aref; aref="$(anchor_issue_ref "$MANAGE_SELECTED_NUM" "$GH_OWNER")"
  if [[ -n "$aref" ]]; then
    gh issue comment "${aref##*#}" --repo "${aref%%#*}" --body "**C02 reassignment** — $today
- from: ${current_assignee:-(unassigned)}
- to: $NEW_ASSIGNEE
- reason: $REASON
- approved-by: $CURRENT_USER" >/dev/null 2>&1 \
      && ok "C02 audit comment posted on anchor $aref." \
      || warn "Could not post C02 audit comment on anchor $aref — record it manually."
  else
    warn "No anchor issue on this board — C02 audit comment not posted (seed the project to create one)."
  fi
  echo ""
  ok "Reassigned to '$NEW_ASSIGNEE'. C02 recorded: reason, approver, timestamp."
}

cmd_manage_unassign() {
  header "Unassign Project"
  divider
  label "Remove the current assignment, leaving the project unassigned."
  echo ""
  select_from_owner_projects PROJECT_ID "assigned"
  echo ""

  local current_assignee=""
  current_assignee="$(project_owners "$MANAGE_SELECTED_NUM" "$GH_OWNER" | paste -sd ',' -)"

  echo -e "  ${BOLD}Current assignee:${NC} ${current_assignee:-${DIM}(unassigned)${NC}}"
  echo ""
  confirm "Remove assignment from this project?"
  echo ""

  # Remove every current owner: anchor assignee + board write access (GitHub-SoT,
  # no registry write).
  local _o
  if [[ -n "$current_assignee" ]]; then
    IFS=',' read -ra _olist <<< "$current_assignee"
    for _o in "${_olist[@]}"; do
      [[ -n "$_o" ]] && manage_apply_owner remove "$MANAGE_SELECTED_NUM" "$MANAGE_SELECTED_URL" "$_o"
    done
  fi
  echo ""
  ok "${MANAGE_SELECTED_PID:-Board} is now unassigned (anchor assignees cleared + board access revoked)."
}

