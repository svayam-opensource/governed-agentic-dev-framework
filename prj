      echo -e "${BOLD}(7) Help${NC}   ${DIM}prj command-line use${NC}"
      echo "  help [--detail] · help <command>   this reference · per-command examples"
      echo "  version                         print the installed prj CLI version"
      echo ""
      echo -e "  ${DIM}prj help <command>${NC}   command-specific help + examples"
      echo ""
      ;;
    "")
      echo ""
      echo -e "${BOLD}Usage:${NC} prj <command> [args]"
      echo ""
      echo -e "${BOLD}Common commands${NC}"
      echo "  work        Continue work — sync your branch and keep going"
      echo "  deploy      Deploy a target — local/dev/uat/prod"
      echo "  data        Query a unit's datastore — list units + canned diagnostics"
      echo "  manage      List, assign, reassign, unassign projects"
      echo "  version     Print the installed prj CLI version"
      echo ""
      echo -e "  ${DIM}prj help --detail${NC}    all commands"
      echo -e "  ${DIM}prj help <command>${NC}   help + examples for one command"
      echo -e "  ${DIM}prj${NC}                  (no args) interactive menu"
      echo ""
      ;;
    config)
      cat <<'EOF'
prj config scaffold <unit> [--write] | prj config check <path>

The (a)-step of config-as-build: build a unit's deploy config like code is built. The tool
PROPOSES a per-unit deploy.yaml — you review, never author from blank. Two halves:
  derived:  mechanical facts re-derived from the unit's package.json closure + config map
            (kind, artifact, paths, depends_on, requires). REVIEW; CI drift-gates them.
  intent:   facts the tool can't know — edge slug, healthcheck, serve, hooks. AUTHOR/own.

  scaffold <unit>        print a proposed deploy.yaml for the unit (reads the working tree)
  scaffold <unit> --write  write it to <repo>/<anchor>/deploy.yaml
  check <path>           drift gate: assert a committed deploy.yaml's derived block == fresh

Examples:
  prj config scaffold svm-ident             propose svm-ident's deploy.yaml for review
  prj config scaffold svm-ident --write     write packages/api/iam/deploy.yaml
  prj config check packages/api/iam/deploy.yaml   CI: fail if derived facts drifted
EOF
      ;;
    deploy)
      cat <<'EOF'
prj deploy <target> <--local | --dev | --uat | --prod> [flags]

Deploy an application or service. ONE verb; the backend differs by env:
  --local              watch/serve orchestrator (auto-provisions; serves SPAs natively)
  --dev/--uat/--prod   build-once-promote via Jenkins

An environment is REQUIRED. <target> is an app (e.g. portal) or a service (e.g. svm-ident).

Flags:
  --seed             local: FRESH reseed — WIPES the data volume, re-migrates, then loads
                     curated init data (a clean known baseline, not last-shutdown data).
                     Implies provisioning; prompts to confirm unless -y/--yes.
  --no-provision     local: skip auto-provision (local auto-provisions by default)
  --provision        remote: stand up missing Tier-2 (remote default: halt-with-guidance)
  -d, --detach       background it (local: detach serve; remote: don't tail the build)
  --image            local: run the real container image instead of the native dev-server
  --pin <tag>        pin an immutable image tag (rollback / build-once-promote)
  --branch <name>    base branch for the build
  --agent <label>    Jenkins agent label
  --dry-run          show what would run; execute nothing
  -y, --yes          skip confirmation prompts (uat/prod deploy; local --seed wipe)
  --stop [--all]     local: stop the SPA (--all also stops Tier-2 containers)
  --logs             local: tail the serve logs

Examples:
  prj deploy portal --local                    bring up locally (auto-provision + serve)
  prj deploy portal --local --seed             + load curated data (fresh bring-up)
  prj deploy portal --local -d                 detached (returns; serves in background)
  prj deploy portal --local --stop --all       full local teardown (SPA + Tier-2)
  prj deploy svm-ident --uat --pin 0.1.0-uat.3 promote a pinned rollback to uat
  prj deploy portal --prod --dry-run           preview the prod deploy, run nothing
EOF
      ;;
    publish)
      cat <<'EOF'
prj publish [<ref>] [--dist-tag <tag>] [--dry-run] [-y] [--no-follow]

Ship the prj CLI to npm through the framework's OWN governed Jenkins job (the
single interface — no laptop `npm publish`). Triggers <workspace>/publish/prod/prj
(auto-provisioned): clones the CLI source repo at <ref>, gates it (syntax +
version-sync + npm pack), then `npm publish` with the npm token from the Jenkins
credential `npmjs-token`. The token lives in Jenkins, never on a developer machine.

  <ref>           tag/branch/SHA to publish (default: v<package.json version>)
  --dist-tag      npm dist-tag (default: latest)
  --dry-run       run the gate + `npm publish --dry-run` only — publishes nothing
  -y, --yes       skip the irreversible-publish confirmation
  --no-follow     trigger and return (don't tail the Jenkins build)

Examples:
  prj publish --dry-run            full gate + dry-run for the current version
  prj publish v0.8.0               publish tag v0.8.0 to npm as 'latest'
  prj publish v0.8.1 --dist-tag next   publish under the 'next' tag
EOF
      ;;
    seed)
      cat <<'EOF'
prj seed <args> — run the catalog-declared `seed` hook (app-owned script).

The catalog declares hooks.seed = { repo, cmd }; prj runs it from the owner repo with
$ADF_WORKSPACE exported and your args forwarded. App logic lives in the app, not the CLI.

Examples:
  prj seed iam --env local     seed the local IAM with curated data (env-data/local.yaml)
EOF
      ;;
    catalog)
      cat <<'EOF'
prj catalog <local|dev|uat|prod>        discover units in an env (env REQUIRED)
prj catalog dag [<unit|app|service>] [--env <env>] [--format <tree|mermaid>]
                                        show the derived dependency DAG
prj catalog add [<unit>]                define a NEW unit (interactive, env-agnostic)
prj catalog update <unit>               revise an existing unit's declared facts
prj catalog rm <unit>                   show how to remove a unit (+ dangling-edge scan)
prj catalog build                       (re)derive graph.lock from services.yaml + repos
prj catalog check                       drift-gate: assert graph.lock == a fresh derivation

LIST (prj catalog <env>): each unit's kind, the host it runs on in that env, its DEPLOYED
(pinned) version (– = not deployed there), and its resolved edge host; plus applications
and platform services.

DAG: the derived dependency graph — `depends_on` (build edges) + `requires` (runtime edges
to platform services). The TOPOLOGY is env-invariant, so `--env` is OPTIONAL: without it you
get the structure; with `--env` each node is decorated with that env's host / pin / edge and
each runtime edge is resolved to its endpoint (e.g. SVC_OIDC → auth.svayamtech.com). Derived
LIVE (never reads/writes graph.lock). `--format mermaid` emits a paste-able diagram.
A platform-service target shows its detail: DATA stores show type / model version / data
location + seed/restore; EXTERNAL targets show surface / protocol / auth / identity / secret
LOCATION (a reference — never the secret). Unit edges tag the dep as data/stateful/external.

ADD / UPDATE / RM author the catalog. A unit is defined ONCE for ALL envs (no --env) — only
its deploy PIN promotes dev→uat→prod (`prj deploy <unit> --<env>`). `add`/`update` prompt for
the DECLARED facts only (repo, anchor|declared-only, kind, requires, per-env hosts, edge,
healthcheck) and PROPOSE a services.yaml block (POL-086-safe — review + place under
`services:`, graduates at close). `rm` prints the removal + warns about units still
referencing it. After placing a change: `prj catalog build` then `prj catalog check`.

Examples:
  prj catalog dev                        units + hosts + what's deployed in dev
  prj catalog dag knowledge-rp --env prod   that unit's deps, resolved for prod
  prj catalog dag --format mermaid       the whole graph as a Mermaid diagram
  prj catalog add my-svc                 guided new-unit authoring
  prj catalog build                      regenerate graph.lock after editing services.yaml
EOF
      ;;
    data)
      cat <<'EOF'
prj data --list <env>                          list the data-capable units (env required)
prj data <unit> <env> [ <name> [k=v…] | --list | --describe <name> | --tables | "<SQL>" ]

Query a unit's datastore. `prj data --list <env>` enumerates the data-capable units; `prj
data <unit> <env> …` dispatches to that unit's data hook. Units ship CANNED diagnostic
queries (right joins + bi-temporal filters; params bind as @vars, read-only).

Workspace resolution is uniform across catalog/deploy/data and keyed on env: local = the WIP
project you're in (cwd, incl. a member repo; else pick); dev/uat/prod = the gov repo
($ADF_WORKSPACE, always on main — set it in your environment). `prj iam-data <env>` == `prj data iam <env>`.

Examples:
  prj data --list dev                         which units have data
  prj data iam local --list                   the IAM unit's canned queries
  prj data iam local --describe user-roles    show one query's SQL + params
  prj data iam dev user-roles email=local1@svayam.ai account=1000 product=portal
  prj data iam local account-subscriptions account=1000
  prj data iam uat "SELECT ..."               ad-hoc SQL (has spaces ⇒ raw)
  prj data iam local                          interactive shell
EOF
      ;;
    iam-data)
      cat <<'EOF'
prj iam-data <env> [ <name> [k=v…] | --list | --describe <name> | --tables | "<SQL>" ]

Run the catalog-declared `iam-data` hook against an env's IAM database (local = the
bundled container; dev/uat/prod via ssh). Beyond ad-hoc SQL and an interactive shell,
it ships CANNED diagnostic queries (diagnostics.sql) that encode the right joins +
bi-temporal filters once; params bind as @vars (read-only, never interpolated).

  prj iam-data local --list                            list the canned queries
  prj iam-data local --describe user-roles             show a query's SQL + params
  prj iam-data local user-roles email=local1@svayam.ai account=1000 product=portal
  prj iam-data local user-accounts email=local1@svayam.ai
  prj iam-data local account-subscriptions account=1000
  prj iam-data local --tables                          list iam_* tables + row counts
  prj iam-data uat "SELECT ..."                        ad-hoc SQL (has spaces ⇒ raw)
  prj iam-data local                                   interactive mariadb shell
EOF
      ;;
    creds)
      cat <<'EOF'
prj creds <subcommand> — manage YOUR per-developer credentials (never shared/committed).

  creds path             print your creds file path
  creds groups           list known credential groups + what they're for
  creds list             KEY names present (values hidden)
  creds add <group>      guided add for a group (e.g. jenkins)
  creds set <KEY> [VAL]  set one key (VAL omitted = hidden prompt)
  creds check <group>    verify a group (e.g. jenkins → authenticates to Jenkins)

Examples:
  prj creds add jenkins
  prj creds check jenkins
EOF
      ;;
    schedules)
      cat <<'EOF'
prj schedules <subcommand> — install/inspect the catalog's scheduled deploys as cron jobs.

  schedules list         show the generated crontab lines (incl. SKIPPED notes)
  schedules install      write the runnable lines into YOUR crontab (idempotent)
  schedules uninstall    remove them from your crontab
EOF
      ;;
    version)
      cat <<'EOF'
prj version | --version | -v — print the installed prj CLI version (from the package).
EOF
      ;;
    manage)
      cat <<'EOF'
prj manage [list | list-all | manage] — assign/reassign/unassign projects (GitHub-definitive).

  manage list        ongoing assignments (GitHub-derived)
  manage list-all    full board universe (from GitHub)
  manage manage      add/remove owners (project) or assignees (issue)
EOF
      ;;
    work)
      cat <<'EOF'
prj work — continue work on your current project: sync your branch(es) with the latest
base branches and keep going. The everyday "pick up where I left off" entry point.
EOF
      ;;
    migrate-home)
      cat <<'EOF'
prj migrate-home — relocate the home governance repo ("gov_repo") to its canonical
deterministic location (gov_workspace, e.g. ~/.<slug>/gov_repo), preserving every
per-project worktree + branch, and record the gov-home pointer file.

  migrate-home            interactive (asks to confirm)
  migrate-home --yes      non-interactive
  migrate-home --to <dir> override the target

Copies (never deletes) the old home; repairs worktrees in place. Idempotent — a
no-op if already canonical.
EOF
      ;;
    start)
      cat <<'EOF'
prj start — guided entry to BEGIN work: join an existing project, create a new
task on a project you're already on, or start a brand-new project. Interactive.

Most days you want `prj work` (continue where you left off). Reach for `start`
when beginning something new and you want to be walked through the choices.

Examples:
  prj start            walk me through join / new-task / new-project
EOF
      ;;
    finish)
      cat <<'EOF'
prj finish — finish the current unit of work: merge a completed TASK back into the
project branch, or — if you're on the project branch — CLOSE the project.
Interactive (detects your context and confirms before acting).

Examples:
  prj finish           merge this task, or close the project if on its branch
EOF
      ;;
    task)
      cat <<'EOF'
prj task — create a TASK sub-branch for parallel work on the current project.
Branches off the project branch so multiple agents/devs work without colliding;
merge it back with `prj merge`. Interactive (prompts for the task name).

Examples:
  prj task             create a new task sub-branch off the project branch
EOF
      ;;
    merge)
      cat <<'EOF'
prj merge — merge a completed TASK sub-branch back into the project branch, then
clean the task branch up. Interactive: pick the task to merge. The pair of
`prj task`.

Examples:
  prj merge            pick a finished task and merge it into the project branch
EOF
      ;;
    pause)
      cat <<'EOF'
prj pause — pause an ACTIVE project (status active → paused), preserving its
branch and worktrees so nothing is lost. Resume later with `prj resume`.
Interactive: pick from your active projects.

Examples:
  prj pause            pause an active project (keeps all branches/worktrees)
EOF
      ;;
    resume)
      cat <<'EOF'
prj resume — resume a PAUSED project (status paused → active). Interactive: pick
from your paused projects.

Examples:
  prj resume           reactivate a paused project
EOF
      ;;
    sync)
      cat <<'EOF'
prj sync — sync your project branch(es) with the latest BASE branches, so you
build on current code (pulls the base in for the workspace + each member repo).
Interactive.

Examples:
  prj sync             bring the latest base branches into your project branch
EOF
      ;;
    init)
      cat <<'EOF'
prj init — (ADVANCED) initialize a new project directly from an anchor issue,
without the guided `start` flow. Most users should use `prj start` or `prj work`.
Interactive.

Examples:
  prj init             create a project workspace from an anchor issue directly
EOF
      ;;
    join)
      cat <<'EOF'
prj join — JOIN an existing project: clone its workspace + member repos and check
out the project branch into your $AGENT_WORK_ROOT. Interactive: pick the project.

Examples:
  prj join             clone + check out an existing project to work on it
EOF
      ;;
    add-repo)
      cat <<'EOF'
prj add-repo — add a code repository to the ACTIVE project: records it in
project.yaml repos[] and clones it on the project branch. Interactive (prompts
for the repo URL + reason). For bringing a repo INTO the framework, see `onboard`.

Examples:
  prj add-repo         attach another code repo to the current project
EOF
      ;;
    cancel)
      cat <<'EOF'
prj cancel — CANCEL a project (status → cancelled) with a recorded reason. Use for
abandoned work; `prj close` is for COMPLETED work. Interactive.

Examples:
  prj cancel           cancel a project and record why
EOF
      ;;
    close)
      cat <<'EOF'
prj close — close a COMPLETED project (status → completed): finalize it, promote
any project knowledge via PR, and archive the project branch. Interactive.
(Standing/common projects don't close — promote their knowledge with `prj knowledge`.)

Examples:
  prj close            wrap up a finished project (+ knowledge promotion)
EOF
      ;;
    knowledge)
      cat <<'EOF'
prj knowledge — propose ORG-knowledge changes via a `knowledge-<slug>` branch off
main → C02 PR. (During an active project, knowledge/ is read-only — changes go
through this reviewed flow, not direct commits.) Interactive; three sub-flows:

  create    make a new knowledge-<slug> branch (then edit knowledge/ + commit)
  submit    open the PR for an existing knowledge branch
  archive   tag + delete a merged knowledge branch

Examples:
  prj knowledge        create / submit / archive a knowledge proposal branch
EOF
      ;;
    onboard)
      cat <<'EOF'
prj onboard — onboard a code repository INTO the framework: add the knowledge/
scaffold, agent entry points, and CI hooks so it participates in governed
development. Interactive. (Distinct from `add-repo`, which attaches an already-
onboarded repo to a specific project.)

Examples:
  prj onboard          prepare a repo to participate in governed development
EOF
      ;;
    list)
      cat <<'EOF'
prj list — list ONGOING projects (active + paused), derived live from the GitHub
boards. No args. See also `prj list-all`.

Examples:
  prj list             show active + paused projects
EOF
      ;;
    list-all)
      cat <<'EOF'
prj list-all — list ALL projects (every board: not-started, ongoing, done),
derived live from GitHub. No args. See also `prj list`.

Examples:
  prj list-all         show the full project universe
EOF
      ;;
    status)
      cat <<'EOF'
prj status [<board-number>] — show one project's status: lifecycle, assignment,
branch, repos, and open board items. Asks for the board NUMBER if omitted.

Examples:
  prj status 43        status of PRJ-43 (GitHub board #43)
  prj status           prompt for the board number
EOF
      ;;
    deps)
      cat <<'EOF'
prj deps — install / verify the tools prj needs for THIS OS (gh, git, jq, and a
YAML reader: PyYAML or the yq binary). Idempotent; safe to re-run. No args.

Examples:
  prj deps             check + install missing dependencies
EOF
      ;;
    upgrade)
      cat <<'EOF'
prj upgrade [<version>] — pull a new framework version from the `template` git
remote and apply it, preserving your org-config + project data. Requires a remote
named `template`. Omit <version> for the latest.

Examples:
  prj upgrade          upgrade to the latest template version
  prj upgrade 0.7.4    upgrade to a specific version / tag
EOF
      ;;
    validate)
      cat <<'EOF'
prj validate — run the workspace VALIDATOR over knowledge/ + the registry (schema,
front-matter, links, lifecycle, secrets, exec-bits, version-sync) — the same gate
CI runs. No args; non-zero exit on any violation.

Examples:
  prj validate         run all workspace checks locally before pushing
EOF
      ;;
    *)
      err "Unknown command '$topic'. Run 'prj help' for common commands, 'prj help --detail' for all."
      return 1
      ;;
  esac
}

cmd_migrate_home() { bash "$SCRIPTS/migrate-home.sh" "$@"; }

# ── Entry point ───────────────────────────────────────────────────────────────

CMD="${1:-}"

# Write commands need a configured git identity (they call git commit
# during the flow). Read-only commands don't.
case "$CMD" in
  init|task|merge|pause|resume|sync|add-repo|cancel|close|knowledge|onboard|manage|upgrade|start|work|finish)
    require_git_identity
    ;;
esac

case "$CMD" in
  "")           show_menu ;;
  init)         cmd_init ;;
  join)         cmd_join ;;
  start)        cmd_start ;;
  work)         cmd_work ;;
  finish)       cmd_finish ;;
  task)         cmd_task ;;
  merge)        cmd_merge ;;
  pause)        cmd_pause ;;
  resume)       cmd_resume ;;
  sync)         cmd_sync ;;
  config)       cmd_config "${@:2}" ;;
  deploy)       cmd_deploy "${@:2}" ;;
  seed)         cmd_seed "${@:2}" ;;
  publish)      cmd_publish "${@:2}" ;;
  catalog)      cmd_catalog "${@:2}" ;;
  data)         cmd_data "${@:2}" ;;
  iam-data)     cmd_data iam "${@:2}" ;;     # alias: prj iam-data <env> … == prj data iam <env> …
  creds)        bash "$SCRIPTS/creds.sh" "${@:2}" ;;
  schedules)    bash "$SCRIPTS/deploy/schedules.sh" "${@:2}" ;;
  add-repo)     cmd_add_repo ;;
  cancel)       cmd_cancel ;;
  close)        cmd_close ;;
  knowledge)    cmd_knowledge ;;
  onboard)      cmd_onboard ;;
  list)         cmd_list ;;
  list-all)     cmd_list all ;;
  status)       cmd_status ;;
  deps)         cmd_deps ;;
  manage)       cmd_manage "${2:-}" ;;
  upgrade)      cmd_upgrade "${2:-}" ;;
  migrate-home) cmd_migrate_home "${@:2}" ;;
  validate)     cmd_validate ;;
  version|--version|-v)
    # Report the installed CLI version (the bundled package.json is the source of truth).
    _v="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$SCRIPT_DIR/package.json" 2>/dev/null | head -1)"
    echo "prj ${_v:-unknown}"
    ;;
  help|--help|-h)  cmd_help "${2:-}" ;;
  *)
    err "Unknown command '$CMD'. Run './prj help' for usage."
    exit 1
    ;;
esac
