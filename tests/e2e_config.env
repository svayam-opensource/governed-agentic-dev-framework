# tests/e2e_config.env
#
# Constants sourced by tests/e2e_smoke.sh and tests/e2e_cleanup.sh.
# This file is committed to the repo (not gitignored) — its values
# are not secrets, just URLs and IDs the smoke test needs to know.
#
# The PAT itself is NOT here — it's expected in $GH_TOKEN env var,
# set by the maintainer before invoking the smoke test (e.g., from
# ~/.svayam-smoke.env or 1Password CLI).

# Identity that GH_TOKEN must point to. The smoke test asserts
# `gh api user --jq .login` returns this value before proceeding.
# All of these are env-overridable (`: "${VAR:=default}"`) so CI can point the
# same harness at the org sandbox (TESTBED_SANDBOX_ORG) with the bot identity —
# the literal defaults below preserve the standalone release-gate behaviour.
: "${SMOKE_GH_LOGIN:="svayam-ai"}"

# Owner under which throwaway test repos are created.
# The authenticated identity ($SMOKE_GH_LOGIN) must have permission
# to create repos here. SMOKE_TEST_OWNER_TYPE is "user" or "org".
: "${SMOKE_TEST_OWNER:="svayam-ai"}"
: "${SMOKE_TEST_OWNER_TYPE:="user"}"

# Pre-existing fixture GitHub Project. Must:
#   - exist and be readable by SMOKE_GH_LOGIN
#   - have at least one linked Issue (or PR) with a real repo
# Created manually once; never modified by the smoke test. (CI self-provisions a
# throwaway org board and overrides this.)
: "${SMOKE_FIXTURE_PROJECT_URL:="https://github.com/users/svayam-ai/projects/3"}"

# Default branch on the fixture-linked repo(s). seed.sh's --non-interactive
# mode uses default_code_branch from org-config.yaml for every linked repo;
# this must match the actual branch name on the fixture's linked repo, or
# the seed will fail to create the project branch.
# Currently the fixture (svayam-rkant/sanskriti) uses 'master'.
: "${SMOKE_FIXTURE_REPO_BRANCH:="master"}"

# Throwaway test repo naming pattern. Suffix is a Unix timestamp.
SMOKE_REPO_PREFIX="adf-smoke-"

# Public template URL — for documentation only. The smoke test no longer
# clones from this URL (since v0.1.4): a pre-release gate must validate
# what's about to ship, not what's already published, so the smoke pushes
# local publish HEAD into a fresh empty repo instead. This value is here
# only as a reference for post-release release-notes / docs.
SMOKE_PUBLIC_TEMPLATE="svayam-opensource/governed-agentic-dev-framework"

# Default smoke values for the throwaway clone's org-config.yaml.
# Pre-filled by the smoke test (no interactive prompts).
SMOKE_ORG_NAME="ADF Smoke Test"
SMOKE_ORG_SHORT="SmokeT"
SMOKE_ORG_SLUG="SMK"
SMOKE_POLICY_OWNER_EMAIL="smoke@example.com"
