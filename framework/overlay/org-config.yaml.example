# Agentic Development Framework — Organization Configuration
#
# This file is shipped empty by the framework template. An adopting org runs
# ./setup.sh once after cloning the template; that fills in real values here.
# Framework files (CLAUDE.md, AGENTS.md, knowledge/policies/, etc.) read these
# values at runtime, so this is the ONLY file that diverges from the upstream
# template after setup.
#
# Re-run ./setup.sh to update. Do not edit by hand unless you know what you're
# doing — setup.sh overwrites the file.

# Full legal name of your organization
org_name: ""

# Short display name (used in headings and prose)
org_short_name: ""

# Uppercase slug for human display and multi-org disambiguation (2-6 chars).
# Not used in project IDs (which use a literal PRJ- prefix).
org_slug: ""

# Lowercase derivation of org_slug — used for filesystem paths under
# agent_work_root. Auto-derived from org_slug.
org_slug_lower: ""

# Full URL of this workspace repository. 'origin' will be set to this.
org_repo_url: ""

# GitHub organization or username (derived from org_repo_url)
github_org: ""

# Name of this workspace repository (derived from org_repo_url)
workspace_repo: ""

# Default branch name for this workspace repo
default_branch: "main"

# Default base branch for code repositories (used by seed script)
default_code_branch: "dev"

# Per-project workspaces are created under this path. Each gets its own
# folder containing a clone of this workspace repo on the project branch
# plus clones of each impacted code repo on the project branch.
agent_work_root: ""

# Policy Owner details (initial holder of all policy roles at launch)
policy_owner_email: ""
policy_owner_github: ""

# Other role GitHub handles (update as roles are formally assigned)
legal_owner_github: ""
infra_owner_github: ""
system_arch_owner_github: ""
data_arch_owner_github: ""

# Effective date of the policy (YYYY-MM-DD)
policy_effective_date: ""

# Governed service endpoints — read by gov-operate. Declared centrally here for build+deploy+ops 
# Each is a shared config value (a URL), never a secret; the per-USER api_token for each lives in Vault.
#   vault    — the per-user api_token store (jwt/login) + attest target
#   oidc     — the iam-broker OIDC base for `gov-operate auth login` (loopback + PKCE)
#   jenkins  — the org Jenkins base (CI trigger); a deploy triggers a job here as the user
#   npm      — the org npm/Verdaccio registry (publish target for npm units)
#   docker   — the org container image registry (publish target for container units; = default_registry)
services:
  vault: ""
  oidc: "https://security.your-org.com/ident/oidc"
  oidc_client_id: "gov"
  jenkins: "https://jenkins.your-org.com"
  npm: "https://npm.your-org.com"
  docker: "https://docker.your-org.com"

# Gov tenant/account. IAM is multi-tenant; `gov-operate auth login` passes this to the broker (app=gov) so
# the authToken is minted under this account — not left to entitlement/chooser.
gov_account: "<org-account>"

