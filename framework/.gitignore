# Operating system
.DS_Store
Thumbs.db

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Local environment
.env
.env.local

# Node (if any tooling pulls it in)
node_modules/

# Local agent / dev workspaces — created by the framework outside of org's tree
work/

# Per-user local IDE configurations
.claude/local-settings.json

# Session-start gate (#54 Layer 2): commit the gate config, keep local state out.
# Everything under .claude/ is ignored EXCEPT the committed gate files.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/commands/
.claude/settings.local.json
.claude/.session-ack
.cursor/.session-ack
