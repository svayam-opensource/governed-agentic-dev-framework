# Operating system
.DS_Store
**/.DS_Store
Thumbs.db

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Test-bed fixture build artifacts (graph.lock is derived by `catalog build`;
# the .bak files are sed -i.bak backups left by drift tests). The committed
# fixture ships only services.yaml + member package.json sources.
tests/fixtures/**/graph.lock
tests/fixtures/**/*.bak

# Local environment
.env
.env.local

# Node (if any tooling pulls it in)
node_modules/

# TypeScript build output for the ts/* packages (prj-work migration, #91).
# Compiled at publish time; package-lock.json IS committed so CI can `npm ci`.
ts/*/lib/

# Local agent / dev workspaces — created by the framework outside of org's tree
work/

# Per-user local Claude state stays local, but the #54 session-start enforcement
# config is committed (default-on for everyone who clones). Ignore everything
# under .claude/ except the committed hooks/command/settings.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/commands/
.claude/.session-ack

# Governance working root (clones live outside the repo, but never commit a stray one)
/prj_gov/

# Cursor session-start gate marker (per-session runtime state)
.cursor/.session-ack
