{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:svayam-opensource:gov:check-seam:lease-request",
  "title": "lease request",
  "description": "The ONLY body gov-check sends to Svayam: a personal key (local) OR a GitHub OIDC token (CI), the writer PUBLIC key, and usage counts.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "personalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "oidcToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "writerPub": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kty": {
          "const": "OKP"
        },
        "crv": {
          "const": "Ed25519"
        },
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "required": [
        "kty",
        "crv",
        "x"
      ]
    },
    "counts": {
      "$ref": "#/$defs/counts"
    }
  },
  "required": [
    "writerPub",
    "counts"
  ],
  "oneOf": [
    {
      "required": [
        "personalKey"
      ]
    },
    {
      "required": [
        "oidcToken"
      ]
    }
  ],
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "window": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
            },
            "to": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
            }
          },
          "required": [
            "from",
            "to"
          ]
        },
        "writer": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/+-]{0,199}$"
        },
        "records": {
          "type": "integer",
          "minimum": 0
        },
        "agentRecords": {
          "type": "integer",
          "minimum": 0
        },
        "judgeCalls": {
          "type": "integer",
          "minimum": 0
        },
        "gaps": {
          "type": "integer",
          "minimum": 0
        },
        "activeActors90d": {
          "type": "integer",
          "minimum": 0
        },
        "repos": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "window",
        "writer",
        "records",
        "agentRecords",
        "judgeCalls",
        "gaps",
        "activeActors90d",
        "repos"
      ]
    }
  }
}
