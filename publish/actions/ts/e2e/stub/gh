#
# A `gh` that answers from fixtures, so the interactive journey runs with no token, no
# network and no side effects. gov reaches GitHub through `gh` and nothing else, so this
# is the whole seam.
#
# Steered by the environment, one variable per fact the scenario needs to state:
#   GH_STUB_LOGIN            who I am                              (default: adopter-bot)
#   GH_STUB_GOVERNED         "owner/repo,owner/other" already governing the org  (#197)
#   GH_STUB_BOARDS           "number:Title:closed" per board, ';'-separated
#   GH_STUB_ANCHORS          board numbers that HAVE an anchor issue (= seeded)   (#198)
#   GH_STUB_PROJECT          "Title|https://github.com/<owner>/<repo>" — the board `gov seed` reads: that title,
#                            one item linked from that repo (#180, scenario 49)
#   GH_STUB_LOG              a file every invocation is appended to, for assertions
#   GH_STUB_ISSUE_BODY       the body `gh issue view` answers with (every issue is OPEN, titled from its number)
#   GH_STUB_DB               a directory: a fake GitHub WITH A MEMORY (stub/gh-db.mjs) answers the pulls API, issues
#                            and the board first — one run then sees what the last one did (gov autorun, L17)
#   GH_STUB_DB_TOOL          where gh-db.mjs is (default: beside the journey's stubs)
#   GH_STUB_REPOS            "owner/repo,…" that `gh api repos/<owner>/<repo>` can read (unset: the old silence)
#   GH_STUB_ISSUE_FAIL       an owner/repo where `gh issue create` is refused (a failure after a board exists)
set -uo pipefail
: "${GH_STUB_LOGIN:=adopter-bot}"
: "${GH_STUB_GOVERNED:=}"
: "${GH_STUB_BOARDS:=}"
: "${GH_STUB_ANCHORS:=}"
[ -n "${GH_STUB_LOG:-}" ] && printf 'gh %s\n' "$*" >> "$GH_STUB_LOG"

if [ -n "${GH_STUB_DB:-}" ]; then
  node "${GH_STUB_DB_TOOL:-${HERE:-.}/stub/gh-db.mjs}" "$@"; rc=$?
  [ "$rc" -ne 3 ] && exit "$rc"
fi

json_repos() {           # the governance probe's shape
  local out="" r
  IFS=',' read -ra list <<< "$GH_STUB_GOVERNED"
  for r in "${list[@]}"; do [ -n "$r" ] && out="$out\"$r\","; done
  printf '{"repos": [%s], "more": false}' "${out%,}"
}

case "$1" in
  --version) echo "gh version 2.99.0 (gov e2e stub)"; exit 0 ;;
esac

case "$*" in
  "auth status"*)                echo "stub: logged in to github.com as $GH_STUB_LOGIN (repo, read:org, project)" ;;
  # gov asks `gh api user` whether it can act, and reads the scopes from its headers (adoption walk #2).
  "api -i user")                 printf 'HTTP/2.0 200 OK\nX-Oauth-Scopes: project, read:org, repo, workflow\n\n{"login":"%s"}\n' "$GH_STUB_LOGIN" ;;
  "api user --jq .login")        echo "$GH_STUB_LOGIN" ;;
  "api user --jq .login // empty") echo "$GH_STUB_LOGIN" ;;
  "api user"*)                   echo "{\"login\":\"$GH_STUB_LOGIN\"}" ;;

  # "may I create in this org?" — the org exists as far as the stub is concerned.
  "api orgs/"*"--jq .login")     echo "${2#orgs/}" ;;

  # THE GOVERNANCE PROBE (#197/#201). One GraphQL call, answered from GH_STUB_GOVERNED.
  "api graphql"*"org-config.yaml"*) json_repos ;;
  "api graphql"*viewerCanUpdate*) echo "true" ;;
  # The WorkTrackerPort reading one board back (`gov project`): its url, from the number gov asked for. Before the
  # seed read below, whose shortDescription it also names.
  "api graphql"*"fragment p on ProjectV2"*)
      n="$(printf '%s' "$*" | sed -n 's/.*number=\([0-9][0-9]*\).*/\1/p')"
      echo "{\"data\":{\"repositoryOwner\":{\"projectV2\":{\"number\":$n,\"title\":\"stub\",\"closed\":false,\"url\":\"https://github.com/orgs/${GH_STUB_LOGIN}/projects/$n\",\"shortDescription\":\"\"}}}}" ;;
  # THE BOARD SEED READS (projectV2 with its items). One linked item — a board with none fails seed's C01 gate.
  "api graphql"*shortDescription*)
      if [ -n "${GH_STUB_PROJECT:-}" ]; then
        t="${GH_STUB_PROJECT%%|*}"; r="${GH_STUB_PROJECT#*|}"
        printf '{"data":{"organization":{"projectV2":{"id":"PVT_stub","title":"%s","shortDescription":"stub board","items":{"pageInfo":{"hasNextPage":false,"endCursor":null},"nodes":[{"content":{"url":"%s/issues/1","repository":{"url":"%s"}}}]}}}}}' "$t" "$r" "$r"
      else echo "{}"; fi ;;
  "api graphql"*)                echo "{}" ;;

  "api repos/"*"/contents --jq length") echo "42" ;;   # the template copy has finished

  # A change request read back (VcsPort) — before the bare repository read below, which would swallow it.
  "api repos/"*"/pulls/"[0-9]*)
      r="${2#repos/}"; n="${r##*/}"; r="${r%/pulls/*}"
      printf '{"number":%s,"state":"open","merged":false,"draft":false,"title":"stub","html_url":"https://github.com/%s/pull/%s","head":{"ref":"h"},"base":{"ref":"b"}}\n' "$n" "$r" "$n" ;;
  # `gov project` reads each repository before it creates anything (the pre-seed checks, plan 03 L06). Only when the
  # scenario states which exist — every other scenario keeps the silence it was written against.
  "api repos/"*)
      if [ -n "${GH_STUB_REPOS:-}" ] && [ "$#" -eq 2 ]; then
        r="${2#repos/}"
        case ",$GH_STUB_REPOS," in
          *",$r,"*) echo "{\"default_branch\":\"main\",\"html_url\":\"https://github.com/$r\",\"visibility\":\"private\"}" ;;
          *) echo "gh: Not Found (HTTP 404)" >&2; exit 1 ;;
        esac
      fi ;;

  # `gh repo create <owner/repo> --template <framework> --private` (#159).
  #
  # The template IS this repository, so the fixture is a copy of it — pruned of the two
  # things a clone never needs (.git, node_modules) and nothing else. Trimming it to what
  # setup "obviously" reads would be a second, hand-kept idea of the template, drifting from
  # the one gh actually copies; `expectedDirs` and the token sweep would then pass against a
  # shape no adopter receives.
  "repo create "*)
      dest="${GIT_STUB_REMOTES:-}/${3##*/}"
      [ -d "$dest" ] && { echo "stub gh: $3 already exists" >&2; exit 1; }
      mkdir -p "$dest"
      tar -C "${GH_STUB_TEMPLATE:?GH_STUB_TEMPLATE unset}" \
          --exclude=.git --exclude=node_modules --exclude=lib -cf - . | tar -C "$dest" -xf -
      ( cd "$dest" && /usr/bin/git init -q . \
          && /usr/bin/git add -A \
          && /usr/bin/git -c user.email=t@x -c user.name=t commit -qm "template import" )
      echo "https://github.com/$3"
      ;;

  # The starter project (#186): a board, and one issue on it.
  "project create "*)
      : "${GH_STUB_BOARD_N:=7}"
      echo "{\"url\":\"https://github.com/orgs/${GH_STUB_LOGIN}/projects/${GH_STUB_BOARD_N}\",\"number\":${GH_STUB_BOARD_N}}" ;;
  "issue create "*)
      if [ -n "${GH_STUB_ISSUE_FAIL:-}" ] && [[ "$*" == *"--repo $GH_STUB_ISSUE_FAIL "* ]]; then
        echo "HTTP 403: Resource not accessible by integration" >&2; exit 1
      fi
      echo "https://github.com/acme/acme-gov/issues/1" ;;
  # `gov intent` reads its issues through the WorkTrackerPort (`gh issue view <url> --json …`). JSON-escaped body.
  "issue view "*)
      n="${3##*/}"
      printf '{"url":"%s","title":"Issue %s needs doing","body":"%s","state":"OPEN","labels":[],"assignees":[]}\n' \
        "$3" "$n" "${GH_STUB_ISSUE_BODY:-}" ;;
  # The VcsPort opens a change request with `gh api -X POST repos/<o>/<r>/pulls`, then reads it back for its link.
  "api -X POST repos/"*"/pulls "*)
      r="${4#repos/}"; r="${r%/pulls}"
      printf '{"number":12,"html_url":"https://github.com/%s/pull/12"}\n' "$r" ;;
  "project item-add "*) echo '{"id":"PVTI_stub"}' ;;
  # `gov work` lists boards to offer projects. GH_STUB_BOARDS is "num:Title" entries, ';'-separated.
  "project list"*)
      out=""; IFS=';' read -ra bs <<< "${GH_STUB_BOARDS:-}"
      for b in "${bs[@]}"; do
        [ -n "$b" ] || continue
        n="${b%%:*}"; t="${b#*:}"
        out="$out{\"number\":$n,\"title\":\"$t\",\"url\":\"https://github.com/orgs/$GH_STUB_LOGIN/projects/$n\",\"closed\":false},"
      done
      printf '{"projects":[%s]}' "${out%,}" ;;
  "project item-list"*) echo '{"items":[]}' ;;

  # THE ANCHOR SEARCH — which boards are SEEDED, and who is assigned to them (#198).
  #
  # `GH_STUB_ANCHORS` was documented here from the day this stub was written and never answered: the case fell
  # through to `*) :`, gh printed nothing, and `findAll` parsed "" — an exception it catches, so every board in
  # every scenario looked un-seeded. That is fine for a scenario about seeding and wrong for one about the
  # picker, whose whole point is that "yours" and "could start" are DIFFERENT lists. Board numbers, comma- or
  # semicolon-separated; the anchor body carries the board number, which is how gov maps issue → board.
  "issue list"*)
      out=""; IFS=',;' read -ra as <<< "${GH_STUB_ANCHORS:-}"
      for n in "${as[@]}"; do
        [ -n "$n" ] || continue
        out="$out{\"url\":\"https://github.com/$GH_STUB_LOGIN/gov/issues/$n\",\"number\":$n,\"body\":\"Anchor issue for the project on GitHub Project #$n\",\"labels\":[],\"assignees\":[{\"login\":\"$GH_STUB_LOGIN\"}]},"
      done
      printf '[%s]' "${out%,}" ;;

  # THE PIVOT CLONES WITH `gh`, not git (#197): gh knows the protocol and carries the token,
  # so a private governance repo works on a machine whose only credential is `gh auth login`.
  # Serving it here is what proves gov took that route rather than guessing a URL.
  "repo clone "*)
      src="$3"; dest="${4:-${3##*/}}"
      if [ -d "${GIT_STUB_REMOTES:-}/${src##*/}" ]; then
        /usr/bin/git clone -q "${GIT_STUB_REMOTES}/${src##*/}" "$dest" || exit 1
        # AND SET origin, because the real `gh repo clone` does. Without it `deriveOrgConfig`
        # has no origin URL to derive from, every default in `gov setup` comes out empty, and
        # the first question rejects the empty answer it just offered. That is a plausible
        # gov defect the harness would have reported — and it was the double, not gov.
        /usr/bin/git -C "$dest" remote set-url origin "https://github.com/$src.git" 2>/dev/null \
          || /usr/bin/git -C "$dest" remote add origin "https://github.com/$src.git"
      else
        echo "stub gh: no fixture for $src" >&2; exit 1
      fi
      ;;

  *) : ;;                                              # silence beats a wrong answer
esac
exit 0
