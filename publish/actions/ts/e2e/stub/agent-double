#
# An agent that does nothing but say precisely how it was called.
#
# #199 (five agents launched a shell), #207 (a prompt passed as an argument the agent
# rejects) and #209 (the agent gone once gov exits) are all facts about the EXEC — which
# binary, which argv, which directory, and whether it is reachable at all. A vendor CLI
# cannot assert those and would need a network and an account to try. This can, and the
# record it leaves is the assertion.
set -uo pipefail
me="$(basename "$0")"
[ "${1:-}" = "--version" ] && { echo "$me 9.9.9 (gov e2e double)"; exit 0; }
: "${AGENT_DOUBLE_LOG:=/dev/null}"
{
  printf 'cmd=%s\n' "$me"
  printf 'cwd=%s\n' "$PWD"
  printf 'argc=%s\n' "$#"
  # WHAT THE AGENT WAS ACTUALLY GIVEN. #199 and #207 are about the argv; this is about the
  # environment, and it is the half nothing checked: gov collected a key, wrote it to disk,
  # and then launched the agent without it, so the agent asked for a browser it could not
  # open. Presence only — a test that logs a secret is a test that leaks one.
  for v in BOB_API_KEY ANTHROPIC_API_KEY OPENAI_API_KEY GEMINI_API_KEY; do
    [ -n "${!v:-}" ] && printf 'env=%s:set\n' "$v"
  done
  i=1; for a in "$@"; do printf 'arg%s=%s\n' "$i" "$a"; i=$((i+1)); done
  printf '%s\n' '--'
} >> "$AGENT_DOUBLE_LOG"

# A FIRST-RUN GATE, THE WAY A REAL VENDOR HAS ONE.
#
# IBM Bob refuses a first message until its licence is accepted:
#
#     Error: A license agreement is required. Please accept the license terms before proceeding.
#
# and it refuses in the very mode gov uses to deliver the protocol, so the licence screen it
# tells you to go and find can never appear. gov's answer is to hand the terminal over, let the
# person settle it, and retry — which is untestable without an agent that actually refuses.
#
# Armed by pointing AGENT_DOUBLE_LICENCE at a path. While that file is absent, a run carrying a
# prompt fails the way Bob fails; a run with NO arguments is the interactive one, so it creates
# the file and succeeds — the double's stand-in for a person reading and pressing `y`.
if [ -n "${AGENT_DOUBLE_LICENCE:-}" ] && [ ! -f "$AGENT_DOUBLE_LICENCE" ]; then
  if [ "$#" -gt 0 ]; then
    echo "Error: A license agreement is required. Please accept the license terms before proceeding." >&2
    echo "Launch $me in interactive mode to accept it." >&2
    exit 3
  fi
  : > "$AGENT_DOUBLE_LICENCE"
  echo "  [$me] licence accepted"
fi

# AND THE GATE BEHIND THE GATE — authentication, which is a different refusal.
#
# The 2026-09-14 walk cleared Bob's licence through gov's handover and then hit:
#
#     Error: Bob API key is required. Set BOB_API_KEY environment variable.
#
# Bob's only other route is a browser sign-in on a loopback callback, which cannot complete in a
# container. So a key is the sole route there, and gov held both facts — the catalog names the
# variable, the environment says it is unset — while printing only "still will not take the
# protocol". Armed with AGENT_DOUBLE_NEEDS_KEY=<VAR>.
if [ -n "${AGENT_DOUBLE_NEEDS_KEY:-}" ] && [ -z "${!AGENT_DOUBLE_NEEDS_KEY:-}" ] && [ "$#" -gt 0 ]; then
  echo "Error: ${me} API key is required. Set ${AGENT_DOUBLE_NEEDS_KEY} environment variable." >&2
  exit 4
fi
# A ONE-SHOT FIRST MESSAGE, AS BOB 2.0.4 ENDS ONE (PRJ-121, 2026-09-22). `bob -p` answers, prints a summary
# with its task id, and exits; gov reads the id and reopens the session with `chat --resume <id>`. The line is
# spaced exactly as the walk's log showed it, so the pattern gov uses is exercised against the real shape.
if [ "${1:-}" = "-p" ]; then
  echo "Task Summary"
  echo "Task ID:                 0123456789abcdef0123456789abcdef"
fi
exit 0
