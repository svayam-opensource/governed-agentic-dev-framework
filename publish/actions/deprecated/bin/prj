#!/usr/bin/env bash
# @svayam-opensource/prj — DEPRECATED. This is a pure redirect shim.
#
# prj is retired (svm-prj-work:#290, decision D-001, 2026-08-09). It enforced the
# registry.yaml / project.yaml authority model; GitHub is now the sole source of
# truth, and the lifecycle ships as `gov` with build/deploy/data as `gov-cicd`.
#
# WHY THIS IS A RELEASE AND NOT JUST AN `npm deprecate`:
# `npm deprecate` warns at INSTALL time. An already-installed prj warns nobody and
# still EXECUTES against live governance repos — creating branches, pushing them,
# writing state — on an authority model the org has abandoned. Replacing its
# behaviour with a map is a safety release. Nothing below this line runs any
# lifecycle logic: this shim resolves nothing, touches no repo, and either execs
# the successor or prints where the verb went. That is deliberate — it also means
# the age of the surrounding tree cannot leak into anyone's workspace.
#
# The routing rule (svm-prj-work:#290, Policy Owner): name a successor ONLY where
# the successor does the same thing. A wrong pointer in a published, deprecated
# CLI is a lie nobody will ever come back to fix. Verbs whose fate is genuinely
# unsettled say so and name nothing.
set -uo pipefail

VERB="${1:-}"
shift || true

note() { printf '%s\n' "$*" >&2; }

banner() {
  note "prj is deprecated and no longer does any work of its own."
  note "  Lifecycle → gov      ·      build / deploy / data → gov-cicd"
  note "  Why: https://github.com/Svayamtech/svm-prj-work/issues/290"
  note ""
}

# redirect <target-binary> <target-verb...> — announce, then hand over.
redirect() {
  local bin="$1"; shift
  banner
  note "  '$VERB' is now:   $bin $*"
  note ""
  if ! command -v "$bin" >/dev/null 2>&1; then
    note "  ...but '$bin' is not installed. Install it, then re-run:"
    note "      npm i -g @svayam-opensource/gov-work"
    exit 127
  fi
  exec "$bin" "$@"
}

# gone <headline> <line...> — the verb has no successor to hand over to.
gone() {
  banner
  note "  $1"
  shift
  for line in "$@"; do note "  $line"; done
  note ""
  exit 1
}

case "$VERB" in
  # ── Lifecycle · same verb, new binary ──────────────────────────────────────
  list|list-all|status|work|task|merge|sync|join|pause|resume|cancel|close|\
  manage|knowledge|onboard|add-repo|upgrade|deps|doctor|org|anchor|validate|publish)
    redirect gov "$VERB" "$@" ;;

  # ── Lifecycle · renamed ────────────────────────────────────────────────────
  start)
    redirect gov work "$@" ;;

  init)
    # prj init was "(ADVANCED) initialize a new project directly from an anchor
    # issue". gov work is the guided equivalent (it seeds when the project is new
    # and joins when it is not cloned); gov seed is the direct one.
    banner
    note "  'init' is now:   gov work            (guided — seeds if new, joins if not cloned)"
    note "               or: gov seed <board-url>   (direct, as init was)"
    note ""
    exit 1 ;;

  finish)
    # prj finish was context-aware: merge a task, or close the project when on the
    # project branch. Two successors, so it cannot be a single exec.
    banner
    note "  'finish' was two things, and gov keeps them apart:"
    note "      gov merge    hand a completed task back to the project branch"
    note "      gov close    close the whole project (governance gate)"
    note ""
    exit 1 ;;

  # ── Build / deploy / data · moved to gov-cicd ──────────────────────────────
  catalog|data|deploy|creds)
    redirect gov-cicd "$VERB" "$@" ;;

  iam-data)
    # prj dispatched this as an alias: `prj iam-data <env>` == `prj data iam <env>`.
    redirect gov-cicd data iam "$@" ;;

  # ── No successor ───────────────────────────────────────────────────────────
  schedules)
    gone "'schedules' is retired." \
         "It was bespoke operational tooling in the CLI. Catalog cron schedules" \
         "are a unit's own concern now — they belong with the unit, not here." ;;

  migrate-home)
    gone "'migrate-home' is retired." \
         "It relocated a gov repo for a layout that no longer exists." ;;

  backfill-state)
    gone "'backfill-state' is retired." \
         "It backfilled registry.yaml/project.yaml state. There is no such state" \
         "to backfill — GitHub is the source of truth." ;;

  # ── No longer a command ────────────────────────────────────────────────────
  # These are not verbs that moved. The activity is still real; typing is not how
  # you do it any more. Sending someone to a command here would be the lie.
  config)
    # NOTE (#290, open): prj config scaffold/check authored a UNIT's deploy.yaml
    # — the config-as-build step. It belongs to the gov-cicd surface, but no
    # gov-cicd verb has yet been confirmed to do the same thing, so this names
    # none. Do not "fix" this by guessing at gov-cicd standards or drift.
    gone "'config' has no confirmed successor yet." \
         "It scaffolded and drift-checked a unit's deploy.yaml (config-as-build)." \
         "That work lives in the gov-cicd surface; the exact verb is still being" \
         "settled — see svm-prj-work:#290. Nothing here will guess at it." ;;

  seed)
    # DANGER, and the reason this is not a redirect: `prj seed` ran the CATALOG's
    # app-owned seed hook (e.g. seed the local IAM with curated data). `gov seed`
    # CREATES A PROJECT from a board. Same word, unrelated acts. Redirecting this
    # to `gov seed` would be the single most damaging pointer in this file.
    gone "'seed' is NOT 'gov seed' — do not substitute it." \
         "prj seed ran a catalog-declared, app-owned seed hook (data seeding)." \
         "gov seed creates a PROJECT from a board. Unrelated." \
         "The hook is app logic: run it from the owning repo. No CLI successor" \
         "is confirmed — see svm-prj-work:#290." ;;

  # ── Meta ───────────────────────────────────────────────────────────────────
  version|--version|-v)
    echo "prj 0.11.0 (deprecated — redirect shim only; the CLI is 'gov')" ;;

  ""|help|--help|-h)
    banner
    note "  Lifecycle, on gov:"
    note "      work task merge sync join seed close pause resume cancel"
    note "      list list-all status manage anchor knowledge onboard add-repo validate"
    note "  Build / deploy / data, on gov-cicd:"
    note "      catalog build deploy data promote rollback drift standards creds"
    note ""
    note "  Renamed:   start → gov work    ·    finish → gov merge | gov close"
    note "  Retired:   schedules · migrate-home · backfill-state"
    note "  Unsettled: config · seed        (see svm-prj-work:#290 — no guess is made)"
    note ""
    note "  Run 'gov help' or 'gov-cicd menu'."
    exit 0 ;;

  *)
    banner
    note "  Unknown verb '$VERB'. prj no longer implements anything."
    note "  Run 'gov help' or 'gov-cicd menu'."
    exit 1 ;;
esac
